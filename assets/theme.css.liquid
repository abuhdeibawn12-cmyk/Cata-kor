@font-face {
  font-family: "CataKor";
  src: url({{ 'adieu-regular.woff2' | asset_url }}) format("woff2");
  font-display: swap;
}

@font-face {
  font-family: "CataKor";
  src: url({{ 'adieu-bold.otf' | asset_url }}) format("opentype");
  font-weight: 700;
  font-display: swap;
}

:root {
  --green: {{ settings.color_primary }};
  --lime: {{ settings.color_accent }};
  --white: {{ settings.color_background }};
  --ink: #153328;
  --muted: #66736d;
  --soft: #f3f4ef;
  --line: #d9ded7;
  --radius: 18px;
  --page: min(1440px, calc(100% - 64px));
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--white);
  font-family: "CataKor", Arial, sans-serif;
  line-height: 1.45;
  overflow-x: hidden;
}
body.is-locked { overflow: hidden; }
a { color: inherit; text-decoration: none; }
img, video { display: block; max-width: 100%; }
button, input, select { font: inherit; }
button { color: inherit; }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { line-height: .98; letter-spacing: -.035em; }
h1 { font-size: clamp(2.7rem, 6vw, 6rem); }
h2 { font-size: clamp(2rem, 4vw, 4rem); }
.visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0);
  white-space: nowrap; border: 0;
}
.skip-link {
  position: fixed; top: 8px; left: 8px; z-index: 1000;
  padding: 10px 16px; background: var(--white);
  transform: translateY(-150%);
}
.skip-link:focus { transform: none; }
.section-shell { width: var(--page); margin-inline: auto; padding-block: 88px; }
.eyebrow { color: #6d9700; text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; }
.stars, .product-rating span, .review-summary { color: #e3a70d; letter-spacing: .09em; }
.button {
  display: inline-flex; min-height: 48px; align-items: center; justify-content: center;
  gap: 8px; padding: 12px 28px; border: 1px solid transparent; border-radius: 999px;
  cursor: pointer; font-weight: 700; text-transform: uppercase;
}
.button--dark { color: var(--lime); background: var(--green); }
.button--lime { color: var(--green); background: var(--lime); }
.button--outline { border-color: var(--green); background: transparent; }
.button--disabled { color: var(--muted); background: #e9ece8; pointer-events: none; }
.button--full { width: 100%; }
.text-button { border: 0; padding: 0; background: transparent; text-decoration: underline; cursor: pointer; }
.icon-button { border: 0; background: var(--soft); border-radius: 50%; width: 44px; height: 44px; font-size: 2rem; cursor: pointer; }

.announcement {
  min-height: 30px; display: grid; place-items: center;
  color: var(--lime); background: var(--green);
  font-size: .72rem; letter-spacing: .06em; text-transform: uppercase;
}
.site-header {
  width: 100%; min-height: 88px; display: grid;
  grid-template-columns: auto 1fr auto; align-items: center; gap: 44px;
  padding: 14px max(32px, calc((100vw - 1650px) / 2));
  background: rgba(255,255,255,.97); position: relative; z-index: 100;
}
.brand img { width: 190px; height: auto; }
.main-nav { display: flex; align-items: center; gap: 38px; font-size: .86rem; }
.main-nav a:hover, .main-nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
.header-cart {
  position: relative; display: grid; place-items: center;
  border: 0; background: transparent; cursor: pointer; padding: 9px;
}
.cart-count {
  position: absolute; right: -3px; top: -2px; min-width: 20px; height: 20px;
  padding: 0 5px; border-radius: 99px; display: grid; place-items: center;
  color: var(--green); background: var(--lime); font-size: .7rem; font-weight: 700;
}
.mobile-menu-button { display: none; border: 0; background: transparent; }
.mobile-menu-button span:not(.visually-hidden) { display: block; width: 22px; height: 1px; margin: 6px; background: currentColor; }

.home-hero {
  min-height: min(720px, calc(100vh - 118px)); display: grid; grid-template-columns: .9fr 1.35fr;
  background: linear-gradient(90deg,#d5ebff 0%,#e9ffc3 68%,#f2ffbd 100%); overflow: hidden;
}
.hero-copy { align-self: center; padding: 80px max(34px, calc((100vw - 1650px) / 2)); padding-right: 20px; }
.hero-copy h1 { max-width: 620px; margin-bottom: 24px; }
.hero-lead { max-width: 590px; font-size: clamp(1.15rem,2vw,1.7rem); }
.hero-rating { margin: 22px 0; font-size: .8rem; }
.hero-visual { position: relative; display: grid; align-items: center; }
.hero-visual img { width: 110%; max-width: none; transform: translateX(-4%); object-fit: contain; }

.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
.section-heading h2 { max-width: 980px; margin-bottom: 8px; text-transform: uppercase; }
.section-heading--center { display: block; text-align: center; }
.product-grid, .collection-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 20px; }
.product-card, .collection-card {
  min-width: 0; padding: 18px; border-radius: var(--radius);
  background: #496f45; color: white; overflow: hidden;
}
.product-card > a, .collection-card > a { display: flex; height: 100%; flex-direction: column; }
.product-card__top { min-height: 27px; }
.product-card__top span, .collection-card__image > span {
  display: inline-flex; padding: 4px 12px; border-radius: 999px;
  color: var(--green); background: var(--lime); font-size: .68rem; text-transform: uppercase;
}
.product-card img { width: 100%; aspect-ratio: 1; object-fit: contain; }
.product-card h3 { margin: 5px 0; font-size: 1.15rem; text-transform: uppercase; }
.product-card p { min-height: 44px; font-size: .82rem; }
.product-card strong { margin-top: auto; color: var(--lime); font-size: 1.9rem; }

.experts-section { background: #f6f6f4; }
.expert-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 20px; }
.expert-card { min-height: 440px; perspective: 1200px; }
.expert-card__inner { position: relative; width: 100%; height: 100%; transition: transform .6s; transform-style: preserve-3d; }
.expert-card:hover .expert-card__inner, .expert-card:focus .expert-card__inner { transform: rotateY(180deg); }
.expert-card__face { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; backface-visibility: hidden; }
.expert-card__front img { width: 100%; height: 100%; object-fit: cover; }
.expert-card__front::after { content: ""; position: absolute; inset: 45% 0 0; background: linear-gradient(transparent,rgba(0,0,0,.85)); }
.expert-card__front div { position: absolute; z-index: 1; inset: auto 18px 18px; color: white; }
.expert-card__front h3 { margin-bottom: 10px; font-size: 1.45rem; }
.expert-card__front span { display: block; padding: 7px 12px; color: var(--green); background: var(--lime); border-radius: 999px; font-size: .68rem; }
.expert-card__back { transform: rotateY(180deg); padding: 30px; display: flex; flex-direction: column; justify-content: center; color: white; background: var(--green); }
.expert-card__back span { color: var(--lime); }
.expert-card__back p { margin-top: 30px; font-size: 1.1rem; }
.disclosure { margin: 28px 0 0; font-size: .72rem; text-align: center; color: var(--muted); }

.science-banner {
  min-height: 520px; display: grid; grid-template-columns: 1.35fr .65fr; align-items: center;
  padding-left: max(34px,calc((100vw - 1450px)/2));
  background: linear-gradient(110deg,#e0f4cb,#e8ff9a); overflow: hidden;
}
.science-banner__copy { padding: 70px 20px 70px 0; }
.science-banner__copy h2 { max-width: 760px; text-transform: uppercase; }
.science-banner__copy > p { max-width: 760px; }
.science-points { display: flex; gap: 24px; margin: 35px 0; flex-wrap: wrap; }
.science-points span { display: flex; max-width: 200px; align-items: center; gap: 10px; }
.science-points img { width: 48px; height: 48px; }
.science-banner__product { width: 100%; max-height: 540px; object-fit: contain; }

.founder-story { display: grid; grid-template-columns: 1fr .8fr 1fr; align-items: center; gap: 40px; background: #f2f3ef; }
.founder-story__copy h2 { text-transform: uppercase; }
.founder-story > img { align-self: end; }
.founder-story__quote { padding: 35px; border-radius: 20px; background: var(--lime); text-align: center; }
.founder-story__quote p { font-weight: 700; font-style: italic; font-size: 1.15rem; }

.site-footer {
  display: grid; grid-template-columns: 1fr 1fr; gap: 70px;
  padding: 70px max(34px,calc((100vw - 1200px)/2)) 40px;
  color: white; background: var(--green);
}
.footer-brand img { width: 240px; filter: brightness(0) saturate(100%) invert(95%) sepia(28%) saturate(1381%) hue-rotate(23deg) brightness(106%); }
.footer-brand p { margin-top: 26px; font-size: 1.5rem; font-weight: 700; }
.footer-quick-links { display: grid; justify-items: start; gap: 12px; }
.footer-quick-links h2 { font-size: 1rem; letter-spacing: 0; text-transform: uppercase; }
.footer-disclaimer { grid-column: 1/-1; margin: 30px 0 0; padding-top: 25px; border-top: 1px solid rgba(255,255,255,.25); font-size: .65rem; text-align: center; }

.main-product { display: grid; grid-template-columns: minmax(0,1.08fr) minmax(420px,.92fr); gap: 70px; padding-top: 60px; }
.product-gallery { min-width: 0; display: grid; grid-template-columns: 88px minmax(0,1fr); gap: 18px; align-items: start; }
.product-thumbnails { display: grid; gap: 10px; max-height: 700px; overflow-y: auto; }
.product-thumbnails button { padding: 3px; border: 1px solid transparent; background: white; cursor: pointer; }
.product-thumbnails button.is-active { border-color: var(--green); }
.product-thumbnails img { width: 100%; aspect-ratio: 1; object-fit: contain; }
.product-media { position: sticky; top: 20px; min-height: 600px; display: grid; place-items: center; background: radial-gradient(circle,#f0ffc1 0 28%,transparent 29%); }
.product-media__item { display: none; width: 100%; }
.product-media__item.is-active { display: block; }
.product-media__item img, .product-media__item video { width: 100%; max-height: 720px; object-fit: contain; }
.breadcrumbs { display: flex; gap: 8px; margin-bottom: 24px; color: var(--muted); font-size: .82rem; }
.product-details h1 { margin: 12px 0; font-size: clamp(2rem,3vw,3.3rem); text-transform: uppercase; }
.product-description { color: var(--muted); margin-bottom: 26px; }
.product-option-heading h2 { font-size: 1rem; letter-spacing: 0; }
.variant-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
.variant-card {
  position: relative; min-height: 170px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  padding: 24px 12px 15px; border: 1px solid #aab4ad; border-radius: 14px; background: #f7f8f6; cursor: pointer;
}
.variant-card.is-selected { color: white; border-color: var(--green); background: linear-gradient(135deg,#224f2b,#7bbf30); }
.variant-card:disabled { cursor: not-allowed; opacity: .48; }
.variant-card em { position: absolute; top: -10px; padding: 4px 12px; border-radius: 99px; color: var(--green); background: var(--lime); font-size: .6rem; font-style: normal; }
.variant-card img { width: 78px; height: 78px; object-fit: contain; }
.variant-card strong { font-size: 1.05rem; }
.variant-card span { font-size: .75rem; }
.one-time-price {
  display: flex; justify-content: space-between; align-items: center;
  margin: 28px 0 14px; padding: 18px; border: 1px solid #b8c0ba; border-radius: 13px;
}
.one-time-price div { display: grid; gap: 2px; text-transform: uppercase; }
.one-time-price div span { color: var(--muted); font-size: .65rem; text-transform: none; }
.one-time-price b { font-size: 1.5rem; }
.product-submit { border-radius: 12px; }
.product-submit strong { padding-left: 10px; }
.delivery-line { display: flex; justify-content: space-between; gap: 15px; margin: 14px 4px 28px; font-size: .7rem; }
.product-trust { text-align: center; padding: 25px 0; }
.product-trust strong { font-family: Georgia,serif; font-size: 1.5rem; text-transform: uppercase; }
.product-accordions details, .faq-list details { border-top: 1px solid var(--line); }
.product-accordions details:last-child, .faq-list details:last-child { border-bottom: 1px solid var(--line); }
.product-accordions summary, .faq-list summary { display: flex; justify-content: space-between; padding: 18px 0; cursor: pointer; list-style: none; }
.product-accordions details[open] summary span, .faq-list details[open] summary b { transform: rotate(45deg); }
.product-accordions details > div, .product-accordions details > p, .faq-list details > div { padding: 0 0 18px; color: var(--muted); }

.product-benefits { display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; background: #fafbf7; }
.benefit-list { display: grid; gap: 0; }
.benefit-list article { display: flex; gap: 18px; padding: 24px 0; border-bottom: 1px solid var(--line); }
.benefit-list article > span { color: #7faf00; font-size: 1.7rem; }
.benefit-list h3 { margin-bottom: 8px; font-size: 1.45rem; }
.benefit-list p { color: var(--muted); margin: 0; }
.review-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
.review-card { padding: 26px; border: 1px solid var(--line); border-radius: 16px; }
.review-card h3 { margin-top: 15px; }
.review-card small { display: block; color: var(--muted); }
.reviews-app-note { margin-top: 24px; padding: 16px; border-radius: 12px; background: var(--soft); font-size: .8rem; }
.faq-section { display: grid; grid-template-columns: .55fr 1.45fr; gap: 80px; }
.faq-list summary { font-weight: 700; }

.collection-header { text-align: center; margin-bottom: 45px; }
.collection-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
.collection-toolbar select { padding: 10px; border: 1px solid var(--line); border-radius: 9px; }
.collection-card { color: var(--ink); background: white; box-shadow: 0 8px 28px rgba(12,52,24,.13); }
.collection-card__image { position: relative; }
.collection-card__image > span { position: absolute; z-index: 2; top: 8px; left: 8px; }
.collection-card__image img, .collection-card__image svg { width: 100%; aspect-ratio: 1; object-fit: contain; }
.collection-card h2 { min-height: 52px; font-size: 1rem; line-height: 1.2; letter-spacing: -.01em; }
.collection-card p { min-height: 44px; color: var(--muted); font-size: .78rem; }
.collection-card strong { display: block; margin-bottom: 15px; }
.collection-card .button { width: 100%; }
.pagination { display: flex; justify-content: center; margin-top: 40px; }

.cart-page, .standard-page, .empty-state { min-height: 60vh; }
.cart-page__line { display: grid; grid-template-columns: 130px 1fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid var(--line); }
.cart-page__line img { width: 130px; height: 130px; object-fit: contain; }
.cart-page__line h2 { font-size: 1.1rem; }
.cart-page__line input { width: 70px; margin-left: 10px; padding: 8px; }
.cart-page__summary { max-width: 450px; margin: 30px 0 0 auto; display: grid; gap: 12px; }
.cart-page__summary p { display: flex; justify-content: space-between; font-size: 1.25rem; }

.about-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 650px; background: var(--green); color: white; }
.about-hero > div:first-child { align-self: center; padding: 80px max(40px,calc((100vw - 1000px)/4)); }
.about-hero h1 { max-width: 700px; }
.about-hero > img, .about-hero__placeholder { width: 100%; height: 100%; min-height: 650px; object-fit: cover; }
.about-hero__placeholder { display: grid; place-items: center; background: #7f9f79; }
.about-genesis { max-width: 980px; }
.about-genesis h2 { font-size: clamp(2rem,4vw,3.8rem); }
.about-genesis p { font-size: 1.05rem; line-height: 1.8; }
.science-page-hero { padding: 100px 0; background: linear-gradient(115deg,#e1f2cf,#e8ff9e); }
.science-page-hero .section-shell { padding-block: 0; }
.science-page-hero p { max-width: 850px; font-size: 1.1rem; }
.science-standards { display: grid; grid-template-columns: repeat(3,1fr); gap: 25px; }
.science-standards article { padding: 30px; border-radius: 18px; background: var(--soft); }
.science-standards img { width: 60px; height: 60px; }
.science-standards h2 { margin-top: 22px; font-size: 1.5rem; }
.science-evidence { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.science-evidence img { max-height: 520px; object-fit: contain; }

.cart-drawer { position: fixed; inset: 0; z-index: 500; pointer-events: none; visibility: hidden; }
.cart-drawer.is-open { pointer-events: auto; visibility: visible; }
.cart-drawer__overlay { position: absolute; inset: 0; border: 0; background: rgba(4,25,12,.58); opacity: 0; transition: opacity .25s; }
.cart-drawer.is-open .cart-drawer__overlay { opacity: 1; }
.cart-drawer__panel {
  position: absolute; top: 0; right: 0; width: min(510px,100%); height: 100%;
  display: flex; flex-direction: column; padding: 24px; background: white;
  transform: translateX(100%); transition: transform .3s;
}
.cart-drawer.is-open .cart-drawer__panel { transform: none; }
.cart-drawer__header { display: flex; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
.cart-drawer__header h2 { margin: 0; font-size: 1.75rem; text-transform: uppercase; }
.cart-drawer__header p { margin: 5px 0 0; color: var(--muted); font-size: .8rem; }
.cart-drawer__items { flex: 1; overflow-y: auto; }
.cart-line { display: grid; grid-template-columns: 92px 1fr; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--line); }
.cart-line > img { width: 92px; height: 92px; border-radius: 12px; object-fit: contain; background: var(--soft); }
.cart-line strong { display: block; line-height: 1.1; }
.cart-line p { margin: 6px 0; color: var(--muted); font-size: .78rem; }
.quantity-control { display: inline-flex; align-items: center; gap: 14px; margin: 10px 15px 0 0; padding: 4px 9px; border: 1px solid var(--line); border-radius: 999px; }
.quantity-control button { border: 0; background: none; cursor: pointer; font-size: 1.1rem; }
.cart-drawer__footer { padding-top: 18px; border-top: 1px solid var(--line); text-align: center; }
.cart-total { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 1.35rem; text-transform: uppercase; }
.cart-note { color: var(--muted); font-size: .68rem; }
.cart-drawer__footer > .text-button { margin-top: 15px; }
.cart-empty { min-height: 260px; display: grid; align-content: center; justify-items: center; gap: 20px; text-align: center; }

@media (max-width: 1000px) {
  :root { --page: min(100% - 32px, 760px); }
  .site-header { grid-template-columns: auto 1fr auto; min-height: 70px; padding: 10px 16px; gap: 12px; }
  .brand img { width: 140px; }
  .mobile-menu-button { display: block; justify-self: end; }
  .main-nav {
    position: absolute; top: 100%; left: 0; right: 0; display: none;
    padding: 20px; background: white; box-shadow: 0 12px 20px rgba(0,0,0,.08);
  }
  .main-nav.is-open { display: grid; }
  .home-hero { min-height: auto; grid-template-columns: 1fr; }
  .hero-copy { padding: 60px 24px 20px; }
  .hero-visual img { width: 100%; transform: none; }
  .product-grid, .collection-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .expert-grid { grid-template-columns: repeat(2,1fr); }
  .science-banner { grid-template-columns: 1fr; padding: 0 24px; }
  .science-banner__product { max-height: 380px; }
  .founder-story { grid-template-columns: 1fr; }
  .founder-story > img { max-height: 480px; margin-inline: auto; }
  .main-product { grid-template-columns: 1fr; gap: 35px; }
  .product-media { position: relative; top: auto; min-height: 480px; }
  .product-benefits, .faq-section { grid-template-columns: 1fr; gap: 30px; }
  .about-hero { grid-template-columns: 1fr; }
  .about-hero > div:first-child { padding: 60px 30px; }
  .about-hero > img, .about-hero__placeholder { min-height: 450px; }
}

@media (max-width: 640px) {
  :root { --page: calc(100% - 24px); }
  .announcement { min-height: 25px; font-size: .58rem; }
  .section-shell { padding-block: 55px; }
  .section-heading { display: block; }
  .section-heading .button { margin-top: 15px; }
  .product-grid, .collection-grid { grid-template-columns: 1fr; }
  .expert-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .expert-card { min-width: 82vw; scroll-snap-align: start; }
  .science-points { display: grid; }
  .founder-story { gap: 15px; }
  .site-footer { grid-template-columns: 1fr; gap: 40px; padding: 50px 24px 30px; }
  .footer-disclaimer { grid-column: auto; text-align: left; }
  .product-gallery { grid-template-columns: 1fr; }
  .product-thumbnails { grid-row: 2; grid-auto-flow: column; grid-auto-columns: 70px; overflow-x: auto; }
  .product-media { min-height: 340px; }
  .variant-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; }
  .variant-card { min-height: 145px; padding-inline: 5px; }
  .variant-card img { width: 60px; height: 60px; }
  .variant-card strong { font-size: .8rem; text-align: center; }
  .one-time-price { padding: 14px; }
  .review-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .review-card { min-width: 82vw; scroll-snap-align: start; }
  .science-standards, .science-evidence { grid-template-columns: 1fr; }
  .cart-drawer__panel { padding: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
