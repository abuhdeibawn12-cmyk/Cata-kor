<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="icon" type="image/jpeg" href="{{ 'favicon.jpg' | asset_url }}">
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="site-shell template-{{ template.name | handle }}{% if template.name == 'index' or request.path == '/pages/about-us' or template.suffix == 'about' or product.handle == 'nmn' or product.handle == 'liposomal-glutathione' %} exact-home{% endif %}{% if request.path == '/pages/about-us' or template.suffix == 'about' %} about-page{% endif %}{% if request.path == '/pages/science-benefits' or template.suffix == 'science' %} science-page{% endif %}{% if template.name == 'product' %} product-page{% endif %}{% if product.handle == 'nmn' %} secondary-product-page accent-brown{% elsif product.handle == 'liposomal-glutathione' %} secondary-product-page accent-blue{% endif %}{% if template.name == 'collection' %} collection-page{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}
    {% render 'flash-offer-dialog' %}
  </body>
</html>
