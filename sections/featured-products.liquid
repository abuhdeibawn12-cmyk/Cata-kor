{% assign nad = all_products['nad-advanced-500mg'] %}
{% assign nmn = all_products['nmn'] %}
{% assign glutathione = all_products['liposomal-glutathione'] %}

<section class="products-section" id="products">
  <div class="section-heading products-heading">
    <div>
      <h2>{{ 'home.products_title' | t }}</h2>
      <p><b>{{ 'home.guarantee' | t }}</b> <span>·</span> <b>{{ 'home.consumers' | t }}</b></p>
    </div>
    <div class="products-actions">
      <div class="carousel-controls" aria-label="Product carousel controls">
        <button type="button" data-product-scroll="-1" aria-label="Previous products">←</button>
        <button type="button" data-product-scroll="1" aria-label="Next products">→</button>
      </div>
      <a class="lime-button" href="{{ routes.collections_url }}/shop-all">{{ 'home.shop_all' | t }} <span>→</span></a>
    </div>
  </div>

  <div class="product-track" data-product-track tabindex="0" aria-label="Best selling products">
    {% render 'home-product-card',
      product: nad,
      fallback_image: 'product-nad-hq.png',
      fallback_title: 'Liposomal NAD+',
      fallback_price: '$39.99',
      benefit: 'home.daily_energy' | t,
      product_url: routes.root_url | remove_last: '/' | append: '/products/nad-advanced-500mg'
    %}
    {% render 'home-product-card',
      product: nmn,
      fallback_image: 'product-nmn.avif',
      fallback_title: 'NMN Complex',
      fallback_price: '$39.99',
      benefit: 'home.pathway' | t,
      product_url: routes.root_url | remove_last: '/' | append: '/products/nmn'
    %}
    {% render 'home-product-card',
      product: glutathione,
      fallback_image: 'product-glutathione.avif',
      fallback_title: 'Liposomal Glutathione',
      fallback_price: '$39.99',
      benefit: 'home.antioxidant' | t,
      product_url: routes.root_url | remove_last: '/' | append: '/products/liposomal-glutathione'
    %}
    {% render 'home-product-card',
      fallback_image: 'product-caakg.avif',
      fallback_title: 'CA-AKG',
      benefit: 'home.healthy_aging' | t,
      available: false
    %}
  </div>
</section>

{% schema %}
{
  "name": "Cata-Kor products",
  "settings": [],
  "presets": [{ "name": "Cata-Kor products" }]
}
{% endschema %}
