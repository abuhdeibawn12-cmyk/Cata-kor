<footer class="site-footer">
  <div class="footer-brand">
    <a href="{{ routes.root_url }}"><img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="250" height="60"></a>
    <p>AGE ON YOUR TERMS*</p>
  </div>

  <nav class="footer-quick-links" aria-label="Footer navigation">
    <h2>Quick links</h2>
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Shop all</a>
      <a href="/pages/science-benefits">Science and quality</a>
      <a href="/pages/about-us">About Cata-Kor</a>
      <a href="{{ routes.cart_url }}">Shopping bag</a>
    {% endfor %}
  </nav>

  <p class="footer-disclaimer">
    *These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease.
  </p>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Quick links menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
