<footer class="footer" id="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}"><img class="footer-logo" src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="250" height="60"></a>
      <p class="footer-tagline">{{ 'footer.tagline' | t }}</p>
      <a class="footer-contact-link" href="{{ routes.root_url | remove_last: '/' }}/pages/contact" aria-label="{{ 'footer.contact' | t }}">
        {% render 'icon-email' %}
      </a>
    </div>

    <nav class="footer-quick-links" aria-label="{{ 'footer.quick_links' | t }}">
      <h2>{{ 'footer.quick_links' | t }}</h2>
      <a href="{{ routes.root_url | remove_last: '/' }}/pages/science-benefits#coa">COA</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/products/nad-advanced-500mg">{{ 'footer.nad' | t }}</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/products/nmn">{{ 'footer.nmn' | t }}</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/products/liposomal-glutathione">{{ 'footer.glutathione' | t }}</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/pages/science-benefits">{{ 'footer.science_quality' | t }}</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/pages/faqs">FAQs</a>
    </nav>

    <nav class="footer-policy-links" aria-label="{{ 'footer.policies' | t }}">
      <h2>{{ 'footer.policies' | t }}</h2>
      <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{{ 'footer.refund' | t }}</a>
      <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{{ 'footer.shipping' | t }}</a>
      <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'footer.privacy' | t }}</a>
      <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">{{ 'footer.terms' | t }}</a>
      <a href="{{ routes.root_url | remove_last: '/' }}/pages/contact">{{ 'footer.contact_info' | t }}</a>
    </nav>

    <div class="newsletter">
      <h2>{{ 'footer.offers' | t }}</h2>
      <p>{{ 'footer.newsletter' | t }}</p>
      {% form 'customer', class: 'footer-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,exclusive-offers">
        <label class="sr-only" for="FooterNewsletterEmail">{{ 'footer.email' | t }}</label>
        <input
          id="FooterNewsletterEmail"
          type="email"
          name="contact[email]"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ 'footer.email' | t }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button type="submit">{{ 'footer.join' | t }}</button>
        {% if form.posted_successfully? %}
          <span class="footer-newsletter-message" role="status">{{ 'footer.joined' | t }}</span>
        {% elsif form.errors %}
          <span class="footer-newsletter-message" role="alert">{{ 'footer.invalid_email' | t }}</span>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="footer-lower">
    {% if shop.enabled_payment_types.size > 0 %}
      <div class="payment-icons" role="list" aria-label="{{ 'footer.payments' | t }}">
        {% for type in shop.enabled_payment_types %}
          <span role="listitem">{{ type | payment_type_svg_tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <p class="footer-disclaimer">{{ 'footer.disclaimer' | t }}</p>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
