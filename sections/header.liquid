<div class="announcement">
  <a href="{{ routes.collections_url }}/shop-all">
    {{ section.settings.announcement }}
  </a>
</div>

<header class="site-header">
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 420 | image_tag: widths: '180,260,420', alt: shop.name }}
    {% else %}
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="210" height="50">
    {% endif %}
  </a>

  <button class="mobile-menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="MainNavigation">
    <span></span><span></span>
    <span class="visually-hidden">Toggle navigation</span>
  </button>

  <nav class="main-nav" id="MainNavigation" aria-label="Main navigation">
    <a href="{{ routes.collections_url }}/shop-all"{% if request.path == '/collections/shop-all' %} aria-current="page"{% endif %}>Shop</a>
    <a href="{{ routes.collections_url }}/shop-all#products">Best Sellers</a>
    <a href="/pages/science-benefits"{% if template.suffix == 'science' or request.path == '/pages/science-benefits' %} aria-current="page"{% endif %}>Science</a>
    <a href="/pages/about-us"{% if template.suffix == 'about' or request.path == '/pages/about-us' %} class="is-active" aria-current="page"{% endif %}>About</a>
  </nav>

  <div class="header-actions">
    <button class="header-icon-button cart-icon-link" type="button" data-cart-open aria-label="Open shopping bag with {{ cart.item_count }} items">
      {% render 'icon-bag' %}
      <b data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</b>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "EXTRA 15% OFF AT CHECKOUT · USE CODE CATA15"
    }
  ]
}
{% endschema %}
