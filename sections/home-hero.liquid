<section class="home-hero">
  <div class="hero-copy">
    <div class="clinicians-line">
      <b>⌇ {{ 'home.clinicians_choice' | t }} ⌇</b>
      <span>
        {{ 'home.clinicians_line' | t }}
        <a href="https://app.thefrontrowhealth.com/general-store/all?spi=true&utm_campaign=brands_website&utm_content=modal&utm_medium=5469&utm_source=1418&sort=featured&pid=5469">
          {{ 'home.learn_more' | t }}
        </a>
      </span>
    </div>
    <h1>{{ 'home.hero_title' | t }}</h1>
    <p>{{ 'home.hero_copy' | t }}</p>
    <div class="hero-cta-row">
      <div><span class="stars">★★★★★</span> {{ 'home.social_proof' | t }}</div>
      <a class="primary-button" href="#products">{{ 'home.shop_best' | t }}</a>
    </div>
  </div>
  <img
    class="hero-products"
    src="{{ 'hero-products-hq.png' | asset_url }}"
    alt="Cata-Kor longevity supplements"
    width="1800"
    height="1200"
    fetchpriority="high"
  >
</section>

{% schema %}
{
  "name": "Cata-Kor home hero",
  "settings": [],
  "presets": [{ "name": "Cata-Kor home hero" }]
}
{% endschema %}
