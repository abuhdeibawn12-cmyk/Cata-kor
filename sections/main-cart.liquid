<section class="cart-page" data-cart-page>
  <div class="cart-page__inner">
    <header class="cart-page__heading">
      <div>
        <span>{{ 'cart.routine' | t }}</span>
        <h1>{{ 'cart.title' | t }}</h1>
      </div>
      <p>{% if cart.items.size == 1 %}{{ 'cart.selection_one' | t }}{% else %}{{ 'cart.selection_other' | t: count: cart.items.size }}{% endif %}</p>
    </header>

    {% if cart.item_count > 0 %}
      {% assign has_regular_discount_item = false %}
      {% for item in cart.items %}
        {% assign is_regular_discount_item = true %}
        {% if item.properties._flash_offer == 'true' or item.product.tags contains 'flash-offer' or item.product.handle contains '-flash-offer' or item.selling_plan_allocation or item.product.type == 'Bundle' or item.product.handle contains 'bundle-' %}
          {% assign is_regular_discount_item = false %}
        {% endif %}
        {% if is_regular_discount_item %}{% assign has_regular_discount_item = true %}{% endif %}
      {% endfor %}
      <form class="cart-page__form" action="{{ routes.cart_url }}" method="post">
      <div class="cart-page__lines">
        {% for item in cart.items %}
          {% assign is_flash_item = false %}
          {% if item.properties._flash_offer == 'true' or item.product.tags contains 'flash-offer' or item.product.handle contains '-flash-offer' %}{% assign is_flash_item = true %}{% endif %}
          {% assign display_title = item.properties._flash_display_title | default: item.product.title %}
          {% assign display_variant = item.properties._flash_display_variant | default: item.variant.title %}
          <article class="cart-page__line{% if is_flash_item %} is-flash{% endif %}">
            <div class="cart-page__media">
              {% if item.image %}
                {{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', alt: display_title }}
              {% endif %}
            </div>
            <div class="cart-page__details">
              <div class="cart-page__line-heading">
                <div>
                  {% if is_flash_item %}<span class="global-flash-label">{{ 'cart.flash_sale' | t: discount: item.properties._flash_discount }}</span>{% endif %}
                  {% unless is_flash_item %}<a href="{{ item.url }}">{% endunless %}
                    <h2>{{ display_title }}</h2>
                  {% unless is_flash_item %}</a>{% endunless %}
                  <p>
                    {{ display_variant }} ·
                    {% if item.selling_plan_allocation %}{{ item.selling_plan_allocation.selling_plan.name | default: 'Delivered every month · Save 15%' }}{% else %}{{ 'cart.one_time' | t }}{% endif %}
                  </p>
                </div>
                <a class="cart-page__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove' | t }} {{ display_title }}">{{ 'cart.remove' | t }}</a>
              </div>

              <div class="cart-page__line-footer">
                <div class="cart-page__price">
                  {% if is_flash_item and item.properties._flash_original_price_cents %}
                    <del>{{ item.properties._flash_original_price_cents | times: item.quantity | money }}</del>
                  {% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
                {% if is_flash_item %}
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                  <span class="cart-page__fixed-quantity">{{ 'cart.flash_quantity' | t }}: <b>{{ item.quantity }}</b></span>
                {% else %}
                  <label class="cart-page__quantity">
                    <span>{{ 'cart.quantity' | t }}</span>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  </label>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

        <aside class="cart-page__summary">
          <span>{{ 'cart.order_summary' | t }}</span>
          {% if has_regular_discount_item %}
            <div class="cart-discount-progress cart-discount-progress--dark" data-discount-progress>
              <strong>{{ 'cart.cata10_summary' | t }}</strong>
              <div class="cart-discount-progress__track" role="progressbar" aria-label="{{ 'cart.progress_label' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span><b aria-hidden="true">♡</b></div>
            </div>
          {% endif %}
          <p><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>
          <small>{{ 'cart.taxes_shipping' | t }}</small>
          <button class="cart-page__checkout" type="button" data-start-checkout>{{ 'cart.checkout' | t }}</button>
          <button class="cart-page__update" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <a href="{{ routes.collections_url }}/shop-all">{{ 'cart.continue' | t }}</a>
          {% if has_regular_discount_item %}<em>{{ 'cart.threshold_note' | t }}</em>{% endif %}
        </aside>
      </form>
    {% else %}
      <div class="cart-empty">
        <span>0</span>
        <h2>{{ 'cart.empty' | t }}</h2>
        <p>{{ 'cart.empty_copy' | t }}</p>
        <a href="{{ routes.collections_url }}/shop-all">{{ 'cart.shop_products' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
