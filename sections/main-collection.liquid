<section class="collection-hero">
  <span class="eyebrow">CATA-KOR LONGEVITY SUPPORT</span>
  <h1>SHOP ALL</h1>
  <p>Science-driven daily formulas made with transparent dosing and trusted quality.</p>
</section>

<section class="collection-shell" id="products">
  <div class="collection-toolbar">
    <div class="collection-filter-wrap">
      <button class="collection-filter-button" type="button" data-filter-toggle aria-expanded="false">
        Filter: <b data-filter-label>Availability</b><span>+</span>
      </button>
      <fieldset class="collection-filter-menu" data-filter-menu hidden>
        <legend>Availability</legend>
        <label><input type="radio" name="availability" value="all" checked> <span>All products</span></label>
        <label><input type="radio" name="availability" value="in-stock"> <span>In stock</span></label>
        <label><input type="radio" name="availability" value="out-of-stock"> <span>Out of stock</span></label>
      </fieldset>
    </div>
    <div class="collection-sort">
      <span data-visible-count>Products</span>
      <label for="CollectionSort">Sort by:</label>
      <select id="CollectionSort" data-collection-sort>
        <option value="featured">Best selling</option>
        <option value="a-z">Alphabetically, A–Z</option>
        <option value="z-a">Alphabetically, Z–A</option>
      </select>
    </div>
  </div>

  {% assign desired_handles = 'nad-advanced-500mg|liposomal-glutathione|nmn' | split: '|' %}
  <div class="collection-grid" data-collection-grid aria-live="polite">
    {% for desired_handle in desired_handles %}
      {% assign desired_product = all_products[desired_handle] %}
      {% if desired_product != blank %}
        <article
          class="collection-card"
          data-collection-card
          data-title="{{ desired_product.title | escape }}"
          data-available="true"
          data-original-order="{{ forloop.index }}"
        >
          <div class="collection-image-wrap">
            <span class="collection-sale-badge">Sale</span>
            {% if desired_product.featured_image %}
              {{ desired_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360,600,900,1100,1400', alt: desired_product.title }}
            {% endif %}
          </div>
          <div class="collection-card-copy">
            <h2>{{ desired_product.title }}</h2>
            <p>{{ desired_product.metafields.custom.benefit | default: desired_product.description | strip_html | truncatewords: 10 }}</p>
            <a class="collection-product-button" href="{{ desired_product.url }}">View Product</a>
          </div>
        </article>
      {% endif %}
    {% endfor %}

    <article
      class="collection-card is-sold-out"
      data-collection-card
      data-title="Skin, Hair &amp; Nails Supplement"
      data-available="false"
      data-original-order="4"
    >
      <div class="collection-image-wrap">
        <span class="collection-sale-badge">Sale</span>
        <span class="collection-stock-badge">Sold out</span>
        <img src="{{ 'product-caakg.avif' | asset_url }}" alt="Skin, Hair &amp; Nails Supplement" width="1000" height="1000" loading="lazy">
      </div>
      <div class="collection-card-copy">
        <h2>Skin, Hair &amp; Nails Supplement</h2>
        <p>Healthy aging support*</p>
        <button class="collection-product-button is-disabled" type="button" disabled>Out of stock</button>
      </div>
    </article>

    {% render 'collection-bundle-card', handle: 'bundle-nad-nmn', title: 'BUNDLE: LIPOSOMAL NAD+ & NMN COMPLEX', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_NAD.png?v=1783680342', benefit: 'Dual cellular energy support*', order: 5 %}
    {% render 'collection-bundle-card', handle: 'bundle-nmn-glutathione', title: 'BUNDLE: NMN COMPLEX & LIPOSOMAL GLUTATHIONE', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_GLU.png?v=1783680215', benefit: 'Cellular energy and antioxidant support*', order: 6 %}
    {% render 'collection-bundle-card', handle: 'bundle-nad-glutathione', title: 'BUNDLE: LIPOSOMAL NAD+ & GLUTATHIONE', image: blank, benefit: 'Cellular energy and antioxidant defense support*', order: 7, composition: 'nad-glutathione' %}
    {% render 'collection-bundle-card', handle: 'bundle-nad-nmn-glutathione', title: 'BUNDLE: LIPOSOMAL NAD+ & NMN COMPLEX & GLUTATHIONE', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_NAD_GLU.png?v=1783680368', benefit: 'Complete cellular energy and antioxidant support*', order: 8 %}

    {% render 'collection-bundle-card', handle: 'bundle-nmn-ca-akg', title: 'BUNDLE: Cata-Kor NMN Longevity Support & Beauty Blend', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_Ca_Akg.png?v=1783680150', benefit: 'Longevity and beauty blend*', order: 9, force_sold_out: true %}
    {% render 'collection-bundle-card', handle: 'bundle-nad-nmn-ca-akg', title: 'BUNDLE: Cellular Power Trio', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NAD_NMN_Ca_Akg.png?v=1783680182', benefit: 'NAD+, NMN and CA-AKG support*', order: 10, force_sold_out: true %}
    {% render 'collection-bundle-card', handle: 'bundle-nmn-ca-akg-glutathione', title: 'BUNDLE: Ultimate Longevity', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_CA_Akg_GLU.png?v=1783680255', benefit: 'Cellular and antioxidant support blend*', order: 11, force_sold_out: true %}
    {% render 'collection-bundle-card', handle: 'bundle-nad-nmn-ca-akg-glutathione', title: 'BUNDLE: Complete Cata-Kor Collection', image: 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_Ca_Akg_GLU_NAD.png?v=1783680277', benefit: 'Four-formula daily wellness bundle*', order: 12, force_sold_out: true %}
  </div>
</section>

{% schema %}
{"name":"Cata-Kor shop all","settings":[]}
{% endschema %}
