{% if page.handle == 'contact' %}
  <section class="contact-page" aria-labelledby="contact-page-title">
    <div class="contact-page__inner">
      <nav class="contact-page__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ page.title }}</span>
      </nav>

      <header class="contact-page__hero">
        <div>
          <p class="contact-page__eyebrow">Customer care</p>
          <h1 id="contact-page-title">We’re Here To Help.</h1>
        </div>
        <p>Questions about a product or an existing order? Send us a message and our support team will get back to you as soon as possible.</p>
      </header>

      <div class="contact-page__layout">
        <aside class="contact-page__details" aria-label="Contact information">
          <div>
            <span>EMAIL US</span>
            <a href="mailto:support@catakor.store">support@catakor.store</a>
          </div>

          <div>
            <span>ORDER SUPPORT</span>
            <p>Please include your order number so we can help you faster.</p>
          </div>

          <div>
            <span>QUICK ANSWERS</span>
            <a class="contact-page__faq-link" href="/pages/faqs">Visit Our FAQs <span aria-hidden="true">→</span></a>
          </div>

          {% if page.content != blank %}
            <div class="contact-page__content rte">{{ page.content }}</div>
          {% endif %}
        </aside>

        <div class="contact-page__form-card">
          <p class="contact-page__form-kicker">SEND A MESSAGE</p>
          <h2>How Can We Help?</h2>

          {% form 'contact', id: 'ContactForm', class: 'contact-page__form' %}
            {% if form.posted_successfully? %}
              <p class="contact-page__success" tabindex="-1">Thank you. Your message has been sent successfully.</p>
            {% endif %}

            {{ form.errors | default_errors }}

            <div class="contact-page__field-row">
              <div class="contact-page__field">
                <label for="ContactForm-name">Name</label>
                <input
                  id="ContactForm-name"
                  type="text"
                  name="contact[name]"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="Your name"
                >
              </div>

              <div class="contact-page__field">
                <label for="ContactForm-email">Email</label>
                <input
                  id="ContactForm-email"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  required
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="you@example.com"
                >
              </div>
            </div>

            <div class="contact-page__field">
              <label for="ContactForm-order">Order number <span>(optional)</span></label>
              <input
                id="ContactForm-order"
                type="text"
                name="contact[order_number]"
                inputmode="text"
                placeholder="e.g. #1234"
              >
            </div>

            <div class="contact-page__field">
              <label for="ContactForm-message">Message</label>
              <textarea
                id="ContactForm-message"
                name="contact[body]"
                rows="7"
                required
                placeholder="Tell us how we can help"
              >{{ form.body }}</textarea>
            </div>

            <button type="submit">SEND MESSAGE <span aria-hidden="true">→</span></button>
          {% endform %}
        </div>
      </div>
    </div>
  </section>
{% else %}
  <section class="standard-page section-shell">
    <h1>{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Main page",
  "settings": []
}
{% endschema %}
