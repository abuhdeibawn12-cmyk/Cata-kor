{% if product.tags contains 'flash-offer' %}
  <section class="flash-product-redirect" aria-live="polite">
    <p>{{ 'product.private_offer_cart' | t }}</p>
    <a href="{{ routes.collections_url }}/shop-all">{{ 'cart.continue' | t }}</a>
  </section>
  <script>window.location.replace({{ routes.collections_url | append: '/shop-all' | json }});</script>
{% elsif product.type == 'Bundle' %}
  {% render 'bundle-product', product: product %}
{% elsif product.handle == 'nmn' or product.handle == 'liposomal-glutathione' %}
  {% for variant in product.variants %}
    {% if variant.title contains '4' %}{% assign variant_4 = variant %}{% endif %}
    {% if variant.title contains '3' %}{% assign variant_3 = variant %}{% endif %}
    {% if variant.title contains '2' %}{% assign variant_2 = variant %}{% endif %}
    {% if variant.title contains '1' %}{% assign variant_1 = variant %}{% endif %}
  {% endfor %}

  {% if product.handle == 'nmn' %}
    {% assign featured_variant = variant_4 | default: variant_3 %}
    {% assign featured_jar_count = 4 %}
    {% assign featured_delivery_days = 120 %}
  {% else %}
    {% assign featured_variant = variant_3 %}
    {% assign featured_jar_count = 3 %}
    {% assign featured_delivery_days = 90 %}
  {% endif %}

  {% assign featured_subscription = featured_variant.selling_plan_allocations.first %}
  {% assign variant_2_subscription = variant_2.selling_plan_allocations.first %}
  {% assign variant_1_subscription = variant_1.selling_plan_allocations.first %}
  {% for allocation in variant_1.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% unless plan_name contains '2 month' or plan_name contains '3 month' or plan_name contains '4 month' or plan_name contains '60 day' or plan_name contains '90 day' or plan_name contains '120 day' or plan_name contains '2 mes' or plan_name contains '3 mes' or plan_name contains '4 mes' or plan_name contains '60 día' or plan_name contains '90 día' or plan_name contains '120 día' %}
      {% assign variant_1_subscription = allocation %}
    {% endunless %}
  {% endfor %}
  {% for allocation in variant_2.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% if plan_name contains '2 month' or plan_name contains '60 day' or plan_name contains '2 mes' or plan_name contains '60 día' %}{% assign variant_2_subscription = allocation %}{% endif %}
  {% endfor %}
  {% for allocation in featured_variant.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% if product.handle == 'nmn' %}
      {% if plan_name contains '4 month' or plan_name contains '120 day' or plan_name contains '4 mes' or plan_name contains '120 día' %}{% assign featured_subscription = allocation %}{% endif %}
    {% elsif plan_name contains '3 month' or plan_name contains '90 day' or plan_name contains '3 mes' or plan_name contains '90 día' %}
      {% assign featured_subscription = allocation %}
    {% endif %}
  {% endfor %}

  {% if product.handle == 'nmn' %}
    {% assign product_id = 'nmn' %}
    {% assign exact_title = 'NMN 4-IN-1 NAD+ SUPPORT' %}
    {% assign badge = '1000MG' %}
    {% assign subtitle = 'Designed to build, recycle, protect, and activate NAD+ pathways.' %}
    {% assign reviews = '4.9/5 (399+ reviews)' %}
    {% assign main_image = 'https://catakor.com/cdn/shop/files/Main_NMN_42c0bc37-5c6c-48ca-a3cc-4ca3790dca55.png?v=1783680309&width=1100' %}
    {% assign gallery_text = 'https://catakor.com/cdn/shop/files/Main_NMN_42c0bc37-5c6c-48ca-a3cc-4ca3790dca55.png?v=1783680309&width=1100|https://catakor.com/cdn/shop/files/3_NMN_bbce3af2-5504-48dc-970c-fe25fff2a0ad.jpg?v=1783426601&width=1100|https://catakor.com/cdn/shop/files/2_NMN_053d7393-a9db-469d-8ecb-51880935753c.jpg?v=1783426601&width=1445|https://catakor.com/cdn/shop/files/4_NMN_e27e16fe-9161-41bc-b268-0ce9f64cfd55.jpg?v=1783426609&width=1445|https://catakor.com/cdn/shop/files/7_NMN_1352f876-5cda-4e43-a370-8d14e63d9883.jpg?v=1783426609&width=1445|https://catakor.com/cdn/shop/files/5_NMN_4123d42c-2f4a-4c6b-8eed-14ecea140918.jpg?v=1783426444&width=1445|https://catakor.com/cdn/shop/files/5_NMN_4f364f54-6fc8-4ef4-9ab8-3c10b1b05739.jpg?v=1783426609&width=1445|https://catakor.com/cdn/shop/files/9_NMN_bbefea93-83dd-486d-b27d-7f9277d60fb8.jpg?v=1783426608&width=1445|https://catakor.com/cdn/shop/files/8_NMN_d6190cf0-d0a6-46c0-aa2a-4e5e73e22bca.jpg?v=1783426608&width=1445|https://catakor.com/cdn/shop/files/9_NMN.jpg?v=1774889070&width=1445|https://catakor.com/cdn/shop/files/NMN_2_pack-2.png?v=1774889070&width=1445|https://catakor.com/cdn/shop/files/NMN_3_pack-2.png?v=1774889070&width=1445' %}
    {% assign accordion_titles = 'How to Use|Ingredients|Shipping & Guarantee|Third-Party Tested' | split: '|' %}
    {% assign accordion_copies = 'Take two capsules daily with water, with or without food.|NMN, trimethylglycine (TMG), quercetin and trans-resveratrol. See the product label for the complete ingredient list.|Orders include tracked U.S. delivery and are backed by the Cata-Kor money-back guarantee.|Every batch is independently tested for identity, purity and quality before release.' | split: '|' %}
    {% assign featured_daily_cents = featured_variant.price | divided_by: 120.0 %}
  {% else %}
    {% assign product_id = 'glutathione' %}
    {% assign exact_title = 'LIPOSOMAL GLUTATHIONE' %}
    {% assign badge = '1155MG' %}
    {% assign subtitle = 'Glutathione Supplement' %}
    {% assign reviews = '4.9 (107+ reviews)' %}
    {% assign main_image = 'https://catakor.com/cdn/shop/files/Main_Glu.png?v=1783680082&width=1100' %}
    {% assign gallery_text = 'https://catakor.com/cdn/shop/files/Main_Glu.png?v=1783680082&width=1100|https://catakor.com/cdn/shop/files/2_180af383-77a1-4658-bad6-6f56081aea14.jpg?v=1777301848&width=1100|https://catakor.com/cdn/shop/files/Glu_2.jpg?v=1784023438&width=1445|https://catakor.com/cdn/shop/files/4_76de2ec1-d8f9-4fb4-a973-bcde17ca02e4.jpg?v=1777301849&width=1445|https://catakor.com/cdn/shop/files/Glu_4.jpg?v=1784023438&width=1445|https://catakor.com/cdn/shop/files/32.jpg?v=1783426405&width=1445|https://catakor.com/cdn/shop/files/7139FNgEiTL._AC_SL1500.jpg?v=1784023470&width=1445|https://catakor.com/cdn/shop/files/Glu_7.jpg?v=1784023437&width=1445|https://catakor.com/cdn/shop/files/5_1_b1becfa8-499f-4364-95d8-53ede377bb0a.jpg?v=1780499486&width=1445|https://catakor.com/cdn/shop/files/8_COA_test.png?v=1777037332&width=1445|https://catakor.com/cdn/shop/files/9_2d951678-cb63-4457-94bc-e2479151a650.jpg?v=1780499486&width=1445' %}
    {% assign accordion_titles = 'Details|How to Use|Safety|Ingredients' | split: '|' %}
    {% assign accordion_copies = 'A liposomal glutathione formula with vitamin C, selenium, vitamin B2 and resveratrol to support antioxidant activity and cellular defense.*|Take two capsules daily with water, with or without food.|Consult a qualified healthcare professional before use if you are pregnant, nursing, taking medication or managing a medical condition.|Liposomal glutathione, vitamin C, selenium, vitamin B2 and trans-resveratrol. See the product label for the complete ingredient list.' | split: '|' %}
    {% assign featured_daily_cents = featured_variant.price | divided_by: 90.0 %}
  {% endif %}
  {% if request.locale.iso_code == 'es' %}
    {% if product.handle == 'nmn' %}
      {% assign subtitle = 'Diseñado para formar, reciclar, proteger y activar las vías de NAD+.' %}
      {% assign accordion_titles = 'Modo de uso|Ingredientes|Envío y garantía|Probado por terceros' | split: '|' %}
      {% assign accordion_copies = 'Toma dos cápsulas al día con agua, con o sin alimentos.|NMN, trimetilglicina (TMG), quercetina y trans-resveratrol. Consulta la etiqueta para ver la lista completa de ingredientes.|Los pedidos incluyen envío con seguimiento y están respaldados por la garantía de devolución de Cata-Kor.|Cada lote se analiza de forma independiente para verificar su identidad, pureza y calidad antes de su distribución.' | split: '|' %}
    {% else %}
      {% assign subtitle = 'Suplemento de glutatión' %}
      {% assign accordion_titles = 'Detalles|Modo de uso|Seguridad|Ingredientes' | split: '|' %}
      {% assign accordion_copies = 'Fórmula de glutatión liposomal con vitamina C, selenio, vitamina B2 y resveratrol para apoyar la actividad antioxidante y la defensa celular.*|Toma dos cápsulas al día con agua, con o sin alimentos.|Consulta con un profesional sanitario antes de usarlo si estás embarazada, en periodo de lactancia, tomas medicamentos o tienes alguna afección médica.|Glutatión liposomal, vitamina C, selenio, vitamina B2 y trans-resveratrol. Consulta la etiqueta para ver la lista completa de ingredientes.' | split: '|' %}
    {% endif %}
  {% endif %}
  {% assign regular_2_cents = variant_1.price | times: 2 %}
  {% assign regular_featured_cents = variant_1.price | times: featured_jar_count %}
  {% assign save_2_cents = regular_2_cents | minus: variant_2.price %}
  {% assign save_featured_cents = regular_featured_cents | minus: featured_variant.price %}
  {% assign save_2_money = save_2_cents | money %}
  {% assign save_featured_money = save_featured_cents | money %}
  {% assign regular_featured_money = regular_featured_cents | money %}
  {% assign regular_2_money = regular_2_cents | money %}
  {% assign featured_price = featured_variant.price | money %}
  {% assign two_jar_price = variant_2.price | money %}
  {% assign one_jar_price = variant_1.price | money %}
  {% assign featured_each = featured_variant.price | divided_by: featured_jar_count | money %}
  {% assign two_jar_each = variant_2.price | divided_by: 2 | money %}
  {% assign featured_daily = featured_daily_cents | money %}
  {% assign two_jar_daily = variant_2.price | divided_by: 60.0 | money %}
  {% assign one_jar_daily = variant_1.price | divided_by: 30.0 | money %}
  {% assign featured_subscription_savings = featured_variant.price | minus: featured_subscription.price | money %}
  {% assign variant_2_subscription_savings = variant_2.price | minus: variant_2_subscription.price | money %}
  {% assign variant_1_subscription_savings = variant_1.price | minus: variant_1_subscription.price | money %}
  {% assign featured_capsules = featured_jar_count | times: 60 %}
  {% assign gallery_text = gallery_text | replace: 'width=1100', 'width=1600' | replace: 'width=1445', 'width=1600' %}
  {% assign main_image = main_image | replace: 'width=1100', 'width=1600' %}
  {% assign gallery = gallery_text | split: '|' %}

  <section class="secondary-product-hero" data-product-root data-secondary-product="{{ product_id }}">
    <div class="secondary-gallery" data-secondary-gallery>
      <div class="secondary-thumbnail-column">
        <button type="button" class="secondary-thumbnail-arrow" data-thumbnail-shift="-1" disabled aria-label="Show previous product images">↑</button>
        <div class="secondary-thumbnails">
          {% for source in gallery %}
            <button
              class="{% if forloop.first %}is-active{% endif %}"
              type="button"
              data-gallery-index="{{ forloop.index0 }}"
              {% if forloop.index > 6 %}hidden{% endif %}
              aria-label="Show product image {{ forloop.index }}"
            >
              <img src="{{ source | replace: 'width=1600', 'width=240' }}" alt="" width="240" height="240">
            </button>
          {% endfor %}
        </div>
        <button type="button" class="secondary-thumbnail-arrow" data-thumbnail-shift="1" aria-label="Show more product images">↓</button>
      </div>

      <div class="secondary-main-image has-star">
        <span class="secondary-gallery-star" aria-hidden="true"></span>
        <img src="{{ main_image }}" alt="{{ exact_title }} product view 1" width="1600" height="1600" data-secondary-main-image>
        <button class="secondary-image-nav previous" type="button" data-gallery-step="-1" aria-label="Previous product image">‹</button>
        <button class="secondary-image-nav next" type="button" data-gallery-step="1" aria-label="Next product image">›</button>
      </div>
      <script type="application/json" data-secondary-gallery-json>{{ gallery | json }}</script>
    </div>

    <div class="secondary-product-details">
      <div class="secondary-rating">
        <span aria-label="5 out of 5 stars">★★★★★</span>
        <b>{{ reviews }}</b>
      </div>
      <div class="secondary-title-row">
        <h1>{{ exact_title }}</h1>
        <span>{{ badge }}</span>
      </div>
      <p class="secondary-subtitle">{{ subtitle }}</p>

      <div class="secondary-quantity-heading">
        <h2>{{ 'product.select_quantity' | t }}</h2>
        <span data-selected-capsules>{{ 'product.capsules' | t: count: featured_capsules }}</span>
      </div>
      <div class="secondary-pack-grid">
        <button class="secondary-pack is-selected" type="button" data-secondary-pack data-jars="{{ featured_jar_count }}" data-variant-id="{{ featured_variant.id }}" data-total="{{ featured_variant.price | divided_by: 100.0 }}" data-one-time-cents="{{ featured_variant.price }}" data-subscription-cents="{{ featured_subscription.price | default: featured_variant.price }}" data-selling-plan-id="{{ featured_subscription.selling_plan.id }}" data-delivery-days="{{ featured_delivery_days }}"{% if product.handle == 'nmn' %} data-pack-subscription-badge="{{ 'product.nmn_subscribe_badge' | t }}" data-pack-subscription-saving-copy="{{ 'product.save_every_delivery' | t: amount: featured_subscription_savings | escape }}"{% endif %} aria-pressed="true">
          <em>{% if product.handle == 'nmn' %}{{ 'product.best_value' | t }}{% else %}{{ 'product.popular_value' | t }}{% endif %}</em>
          <span class="secondary-pack-image jars-{{ featured_jar_count }}" aria-hidden="true">{% for i in (1..featured_jar_count) %}<img src="{{ main_image }}" alt="" width="160" height="160">{% endfor %}</span>
          {% if product.handle == 'nmn' %}
            <strong class="pack-offer-title">{{ 'product.buy_three_get_one' | t }}</strong>
            <span class="pack-delivery">{{ 'product.jars_delivered' | t: count: 4 }}</span>
            <span class="pack-total"><del>{{ regular_featured_money }}</del> {{ featured_price }} {{ 'product.total' | t }}</span>
          {% else %}
            <strong>3 {{ 'product.jars' | t }}</strong>
            <span class="pack-total">{{ featured_price }} {{ 'product.total' | t }}</span>
          {% endif %}
          <small class="pack-comparison">{{ 'product.save' | t: amount: save_featured_money }} · {{ 'product.per_jar' | t: amount: featured_each }}</small>
          <small class="pack-proof">{{ 'product.only_day' | t: amount: featured_daily }}</small>
        </button>
        <button class="secondary-pack" type="button" data-secondary-pack data-jars="2" data-variant-id="{{ variant_2.id }}" data-total="{{ variant_2.price | divided_by: 100.0 }}" data-one-time-cents="{{ variant_2.price }}" data-subscription-cents="{{ variant_2_subscription.price | default: variant_2.price }}" data-selling-plan-id="{{ variant_2_subscription.selling_plan.id }}" data-delivery-days="60"{% if product.handle == 'nmn' %} data-pack-subscription-badge="{{ 'product.subscribe_badge' | t }}" data-pack-subscription-saving-copy="{{ 'product.save_every_delivery' | t: amount: variant_2_subscription_savings | escape }}"{% endif %} aria-pressed="false">
          {% if product.handle == 'nmn' %}<em>{{ 'product.save_percent' | t: percent: 25 }}</em>{% endif %}
          <span class="secondary-pack-image jars-2" aria-hidden="true">{% for i in (1..2) %}<img src="{{ main_image }}" alt="" width="160" height="160">{% endfor %}</span>
          <strong>2 {{ 'product.jars' | t }}</strong>
          <span class="pack-total">{% if product.handle == 'nmn' %}<del>{{ regular_2_money }}</del> {% endif %}{{ two_jar_price }} {{ 'product.total' | t }}</span>
          <small class="pack-comparison">{{ 'product.save' | t: amount: save_2_money }} · {% if product.handle == 'nmn' %}{{ 'product.per_jar' | t: amount: two_jar_each }}{% else %}{{ 'product.day_supply' | t: days: 60 }}{% endif %}</small>
          {% if product.handle == 'nmn' %}<small class="pack-proof">{{ 'product.only_day' | t: amount: two_jar_daily }}</small>{% endif %}
        </button>
        <button class="secondary-pack" type="button" data-secondary-pack data-jars="1" data-variant-id="{{ variant_1.id }}" data-total="{{ variant_1.price | divided_by: 100.0 }}" data-one-time-cents="{{ variant_1.price }}" data-subscription-cents="{{ variant_1_subscription.price | default: variant_1.price }}" data-selling-plan-id="{{ variant_1_subscription.selling_plan.id }}" data-delivery-days="30"{% if product.handle == 'nmn' %} data-pack-subscription-badge="{{ 'product.subscribe_badge' | t }}" data-pack-subscription-saving-copy="{{ 'product.save_every_delivery' | t: amount: variant_1_subscription_savings | escape }}"{% endif %} aria-pressed="false">
          <span class="secondary-pack-image jars-1" aria-hidden="true"><img src="{{ main_image }}" alt="" width="160" height="160"></span>
          <strong>1 {{ 'product.jar' | t }}</strong>
          <span class="pack-total">{{ one_jar_price }} {{ 'product.total' | t }}</span>
          <small class="pack-comparison">{% if product.handle == 'nmn' %}{{ 'product.per_jar' | t: amount: one_jar_price }} · {% endif %}{{ 'product.day_supply' | t: days: 30 }}</small>
          {% if product.handle == 'nmn' %}<small class="pack-proof">{{ 'product.only_day' | t: amount: one_jar_daily }}</small>{% endif %}
        </button>
      </div>

      {% if product.handle == 'nmn' %}
        {% render 'subscription-plan-selector', product: product, selected_variant: featured_variant, selected_allocation: featured_subscription, selected_delivery_days: featured_delivery_days, enhanced_nmn: true, selected_subscription_savings: featured_subscription_savings %}
      {% else %}
        {% render 'subscription-plan-selector', product: product, selected_variant: featured_variant, selected_allocation: featured_subscription, selected_delivery_days: featured_delivery_days %}
      {% endif %}
      <form action="{{ routes.cart_add_url }}" method="post" data-product-form>
        <input type="hidden" name="id" value="{{ featured_variant.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="1">
        {% if featured_subscription %}<input type="hidden" name="selling_plan" value="{{ featured_subscription.selling_plan.id }}" data-selling-plan-input disabled>{% endif %}
        <button class="secondary-add-button" type="submit" data-add-to-cart>
          <span data-add-label>{{ 'product.add' | t }}</span> <strong data-add-price>{{ featured_variant.price | money }}</strong>
        </button>
      </form>
      <div class="secondary-delivery">
        <span>● {{ 'product.free_tracked' | t }}</span>
        <span>🇺🇸 {{ 'product.free_usa' | t }}</span>
      </div>
      <div class="secondary-guarantee">
        <span aria-hidden="true">◎</span>
        {{ 'product.guarantee_claim' | t }}
      </div>

      <div class="secondary-details-accordions">
        {% for title in accordion_titles %}
          <details {% if forloop.first %}open{% endif %}>
            <summary>{{ title }}<span aria-hidden="true">+</span></summary>
            <p>{{ accordion_copies[forloop.index0] }}</p>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>
{% elsif product.handle == 'nad-advanced-500mg' %}
  {% for variant in product.variants %}
    {% comment %}Match the numeric pack size only so translated option values such as Tarro/Tarros remain valid.{% endcomment %}
    {% if variant.title contains '3' %}{% assign nad_variant_3 = variant %}{% endif %}
    {% if variant.title contains '2' %}{% assign nad_variant_2 = variant %}{% endif %}
    {% if variant.title contains '1' %}{% assign nad_variant_1 = variant %}{% endif %}
  {% endfor %}
  {% assign nad_variant_3_subscription = nad_variant_3.selling_plan_allocations.first %}
  {% assign nad_variant_2_subscription = nad_variant_2.selling_plan_allocations.first %}
  {% assign nad_variant_1_subscription = nad_variant_1.selling_plan_allocations.first %}
  {% for allocation in nad_variant_1.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% unless plan_name contains '2 month' or plan_name contains '3 month' or plan_name contains '60 day' or plan_name contains '90 day' or plan_name contains '2 mes' or plan_name contains '3 mes' or plan_name contains '60 día' or plan_name contains '90 día' %}
      {% assign nad_variant_1_subscription = allocation %}
    {% endunless %}
  {% endfor %}
  {% for allocation in nad_variant_2.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% if plan_name contains '2 month' or plan_name contains '60 day' or plan_name contains '2 mes' or plan_name contains '60 día' %}{% assign nad_variant_2_subscription = allocation %}{% endif %}
  {% endfor %}
  {% for allocation in nad_variant_3.selling_plan_allocations %}
    {% assign plan_name = allocation.selling_plan.name | downcase %}
    {% if plan_name contains '3 month' or plan_name contains '90 day' or plan_name contains '3 mes' or plan_name contains '90 día' %}{% assign nad_variant_3_subscription = allocation %}{% endif %}
  {% endfor %}
  {% assign nad_regular_2_cents = nad_variant_1.price | times: 2 %}
  {% assign nad_regular_3_cents = nad_variant_1.price | times: 3 %}
  {% assign nad_save_2_cents = nad_regular_2_cents | minus: nad_variant_2.price %}
  {% assign nad_save_3_cents = nad_regular_3_cents | minus: nad_variant_3.price %}
  {% assign nad_daily_cents = nad_variant_3.price | divided_by: 90.0 %}
  {% assign nad_save_2_money = nad_save_2_cents | money %}
  {% assign nad_save_3_money = nad_save_3_cents | money %}
  {% assign nad_price_3 = nad_variant_3.price | money %}
  {% assign nad_price_2 = nad_variant_2.price | money %}
  {% assign nad_price_1 = nad_variant_1.price | money %}
  {% assign nad_each_3 = nad_variant_3.price | divided_by: 3 | money %}
  {% assign nad_daily_money = nad_daily_cents | money %}
  {% assign nad_gallery_text = 'https://catakor.com/cdn/shop/files/Main_NAD.png?v=1783679981&width=1100|https://catakor.com/cdn/shop/files/1_NAD500_f37a2f8b-6fd5-43fe-a035-c83a38d54ec4.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/2_NAD500_0ce4c9f5-fb17-4ac1-88c2-d4c4af74fc81.jpg?v=1783421259&width=1100|https://catakor.com/cdn/shop/files/3_NAD500_284becb5-a117-43e4-88d0-7ef566cd05c9.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/4_NAD500_5964a474-23e5-46af-8174-36317bfd56c5.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/5_NAD500_db73c746-222c-4b71-8b49-e692af53d992.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/6_NAD500_0d0e1d1a-b711-4d81-8c41-95cdd9fa436c.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/7_NAD500_Manufactured_for.jpg?v=1783421258&width=1100|https://catakor.com/cdn/shop/files/5_NAD500_a65fca12-ec33-4c89-9817-0919959280a7.jpg?v=1774889169&width=1100|https://catakor.com/cdn/shop/files/7_NAD500_91bae966-e2fe-499f-9161-0c0f42aca355.jpg?v=1774889169&width=1100|https://catakor.com/cdn/shop/files/8_NAD500-2.jpg?v=1774889110&width=1100|https://catakor.com/cdn/shop/files/3_NAD500_8218ca19-959f-4866-9785-0017cff2f5a0.jpg?v=1774889153&width=1100|https://catakor.com/cdn/shop/files/NAD250_2_jars_5e4c06d5-c927-43b1-9da8-f943028f9ece.jpg?v=1774889110&width=1100|https://catakor.com/cdn/shop/files/NAD250_3_jars_33cd95d4-1a11-40c4-a248-3e99cbee0e30.jpg?v=1774889110&width=1100' %}
  {% assign nad_gallery_text = nad_gallery_text | replace: 'width=1100', 'width=1600' %}
  {% assign nad_gallery = nad_gallery_text | split: '|' %}
  {% assign nad_main_image = nad_gallery[0] %}

  <div class="product-layout" data-product-root>
    <div class="product-gallery" data-nad-gallery>
      <div class="thumbnail-rail">
        <button type="button" class="thumbnail-arrow thumbnail-arrow-up" data-nad-thumbnail-shift="-1" disabled aria-label="Show previous product images">‹</button>
        <div class="thumbnail-list" aria-label="Product images">
          <div class="thumbnail-track">
            {% for source in nad_gallery %}
              <button type="button" class="{% if forloop.first %}active{% endif %}" data-nad-gallery-index="{{ forloop.index0 }}" aria-label="View product image {{ forloop.index }}">
                <img src="{{ source | replace: 'width=1600', 'width=240' }}" alt="" width="240" height="240">
              </button>
            {% endfor %}
          </div>
        </div>
        <button type="button" class="thumbnail-arrow thumbnail-arrow-down" data-nad-thumbnail-shift="1" aria-label="Show more product images">›</button>
      </div>
      <div class="main-product-image">
        <span class="product-star-shape" aria-hidden="true"></span>
        <img class="selected-product-image" src="{{ nad_main_image }}" alt="Liposomal NAD+ product image 1" width="1600" height="1600" data-nad-main-image>
        <button class="nad-image-nav nad-image-nav-previous" type="button" data-nad-gallery-step="-1" disabled aria-label="Previous product image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
        <button class="nad-image-nav nad-image-nav-next" type="button" data-nad-gallery-step="1" aria-label="Next product image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
        <div class="gallery-mobile-controls" aria-label="Product image navigation">
          <button type="button" data-nad-gallery-step="-1" disabled aria-label="Previous product image">←</button>
          <span data-nad-gallery-count>1 / {{ nad_gallery.size }}</span>
          <button type="button" data-nad-gallery-step="1" aria-label="Next product image">→</button>
        </div>
      </div>
      <script type="application/json" data-nad-gallery-json>{{ nad_gallery | json }}</script>
    </div>

    <section class="product-info" aria-label="Product information">
      <nav class="breadcrumbs" aria-label="{{ 'product.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'product.home' | t }}</a><span>/</span><b>Liposomal NAD+</b></nav>
      <div class="review-line"><span class="stars">★★★★★</span><b>4.9/5</b> (2200+ reviews)</div>
      <div class="product-title-row"><h1>LIPOSOMAL NAD+</h1><span>500MG</span></div>
      <p class="product-subtitle">{{ 'product.nad_subtitle' | t }}</p>
      <div class="product-facts"><b>{{ 'product.capsules' | t: count: 60 }}</b><span>/</span><b>500MG</b><span>/</span><button type="button" data-facts-open>{{ 'product.supplement_facts' | t }}</button></div>

      <div class="purchase-group">
        <div class="purchase-label"><h2>{{ 'product.select_quantity' | t }}</h2><span data-nad-capsules>{{ 'product.capsules' | t: count: 180 }}</span></div>
        <div class="quantity-options">
          <button type="button" class="quantity-option selected" data-nad-pack data-jars="3" data-variant-id="{{ nad_variant_3.id }}" data-total="{{ nad_variant_3.price | divided_by: 100.0 }}" data-one-time-cents="{{ nad_variant_3.price }}" data-subscription-cents="{{ nad_variant_3_subscription.price | default: nad_variant_3.price }}" data-selling-plan-id="{{ nad_variant_3_subscription.selling_plan.id }}" data-delivery-days="90" aria-pressed="true">
            <em>{{ 'product.popular_value' | t }}</em><span class="quantity-bottles quantity-bottles-3" aria-hidden="true">{% for i in (1..3) %}<img src="{{ nad_main_image }}" alt="" width="120" height="120">{% endfor %}</span><b>3 {{ 'product.jars' | t }}</b><span class="pack-total">{{ nad_price_3 }} {{ 'product.total' | t }}</span><small class="pack-comparison">{{ 'product.save' | t: amount: nad_save_3_money }} · {{ 'product.day_supply' | t: days: 90 }} · {{ 'product.per_jar' | t: amount: nad_each_3 }}</small><small class="pack-proof">{{ 'product.only_day' | t: amount: nad_daily_money }}</small>
          </button>
          <button type="button" class="quantity-option" data-nad-pack data-jars="2" data-variant-id="{{ nad_variant_2.id }}" data-total="{{ nad_variant_2.price | divided_by: 100.0 }}" data-one-time-cents="{{ nad_variant_2.price }}" data-subscription-cents="{{ nad_variant_2_subscription.price | default: nad_variant_2.price }}" data-selling-plan-id="{{ nad_variant_2_subscription.selling_plan.id }}" data-delivery-days="60" aria-pressed="false">
            <span class="quantity-bottles quantity-bottles-2" aria-hidden="true">{% for i in (1..2) %}<img src="{{ nad_main_image }}" alt="" width="120" height="120">{% endfor %}</span><b>2 {{ 'product.jars' | t }}</b><span class="pack-total">{{ nad_price_2 }} {{ 'product.total' | t }}</span><small class="pack-comparison">{{ 'product.save' | t: amount: nad_save_2_money }} · {{ 'product.day_supply' | t: days: 60 }}</small>
          </button>
          <button type="button" class="quantity-option" data-nad-pack data-jars="1" data-variant-id="{{ nad_variant_1.id }}" data-total="{{ nad_variant_1.price | divided_by: 100.0 }}" data-one-time-cents="{{ nad_variant_1.price }}" data-subscription-cents="{{ nad_variant_1_subscription.price | default: nad_variant_1.price }}" data-selling-plan-id="{{ nad_variant_1_subscription.selling_plan.id }}" data-delivery-days="30" aria-pressed="false">
            <span class="quantity-bottles quantity-bottles-1" aria-hidden="true"><img src="{{ nad_main_image }}" alt="" width="120" height="120"></span><b>1 {{ 'product.jar' | t }}</b><span class="pack-total">{{ nad_price_1 }} {{ 'product.total' | t }}</span><small class="pack-comparison">{{ 'product.day_supply' | t: days: 30 }}</small>
          </button>
        </div>
      </div>

      {% render 'subscription-plan-selector', product: product, selected_variant: nad_variant_3, selected_allocation: nad_variant_3_subscription, selected_delivery_days: 90 %}
      <form action="{{ routes.cart_add_url }}" method="post" data-product-form>
        <input type="hidden" name="id" value="{{ nad_variant_3.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="1">
        {% if nad_variant_3_subscription %}<input type="hidden" name="selling_plan" value="{{ nad_variant_3_subscription.selling_plan.id }}" data-selling-plan-input disabled>{% endif %}
        <button type="submit" class="add-to-cart" data-add-to-cart><span data-add-label>{{ 'product.add' | t }}</span><b data-add-price>{{ nad_variant_3.price | money }}</b></button>
      </form>
      <div class="delivery-row"><span>🇺🇸 {{ 'product.free_usa' | t }}</span></div>
      <div class="clinician-box"><b>⌇ {{ 'product.clinicians_choice' | t }} ⌇</b><p>{{ 'product.clinicians_line' | t }}</p><a href="#reviews">{{ 'home.learn_more' | t }}</a></div>
      <div class="guarantee-strip">{{ 'product.guarantee_claim' | t }}</div>
      <div class="product-accordions">
        <details class="product-accordion"><summary>{{ 'product.how_use' | t }}<span>＋</span></summary><div><p>{{ 'product.use_copy' | t }}</p></div></details>
        <details class="product-accordion"><summary>{{ 'product.safety' | t }}<span>＋</span></summary><div><p>{{ 'product.safety_copy' | t }}</p></div></details>
        <details class="product-accordion"><summary>{{ 'product.effects_question' | t }}<span>＋</span></summary><div><p>{{ 'product.effects_copy' | t }}</p></div></details>
      </div>

      <section class="customer-video-section" aria-labelledby="customer-video-title">
        <h2 id="customer-video-title">JOIN 100,000+ OTHERS <span aria-hidden="true">💚</span></h2>
        <div class="story-grid">
          <article class="story-card"><video src="https://cdn.shopify.com/videos/c/o/v/49c88503ac444cceaa07ad0941b19ff2.mov" playsinline preload="metadata"></video><button type="button" class="story-play-button" data-story-play aria-label="Play A solid energy boost">▶</button><h3>A solid energy boost</h3></article>
          <article class="story-card"><video src="https://cdn.shopify.com/videos/c/o/v/626b669d4eae4d0f95088060c2662d1f.mp4" playsinline preload="metadata"></video><button type="button" class="story-play-button" data-story-play aria-label="Play An even better formula">▶</button><h3>An even better formula</h3></article>
          <article class="story-card"><video src="https://cdn.shopify.com/videos/c/o/v/1763917e32c14cbda12acec0ee8bcd3d.mp4" playsinline preload="metadata"></video><button type="button" class="story-play-button" data-story-play aria-label="Play I feel younger">▶</button><h3>I feel younger</h3></article>
        </div>
      </section>
      <nav class="product-jump-links" aria-label="Learn more about this product">
        <h2>Learn more about:</h2><div><a href="#MainContent">↓ <span>How it Works</span></a><a href="#MainContent">↓ <span>Benefits</span></a><a href="#results">↓ <span>Real Results</span></a><a href="#guarantee">↓ <span>Why Cata-Kor</span></a><a href="#reviews">↓ <span>Comparison</span></a><a href="#customer-reviews">↓ <span>Customer Reviews</span></a><a href="#faq">↓ <span>FAQs</span></a></div>
      </nav>
    </section>
  </div>

  <div class="supplement-modal-layer" data-facts-layer hidden>
    <section class="supplement-modal" role="dialog" aria-modal="true" aria-labelledby="supplement-dialog-title">
      <div class="supplement-modal-tabs" role="tablist"><button type="button" class="active" data-facts-tab="facts">Supplement Facts</button><button type="button" data-facts-tab="ingredients">Ingredients</button></div>
      <div class="supplement-facts-panel" data-facts-panel="facts">
        <h2 id="supplement-dialog-title">Supplement Facts</h2><p>Serving Size: 2 Capsules;<br>Servings Per Container: 30</p><div class="facts-heavy-rule"></div>
        <h3><span>Amount Per Serving:</span><span>DV%</span></h3><div class="facts-heavy-rule"></div>
        <div class="facts-row"><strong>LipoNAD™ (providing β-NAD⁺ ≥ 250 mg)</strong><b>500 mg</b></div><div class="facts-row"><span>Trans-Resveratrol</span><b>50 mg</b></div>
        <div class="facts-heavy-rule"></div><strong class="facts-daily-value">** Daily Value (DV) not established</strong>
        <p class="facts-other">Other Ingredients: Sunflower (Helianthus annuus) Lecithin, Silicon Dioxide, Magnesium Stearate, Microcrystalline Cellulose, Vegetable Cellulose (Capsule).</p>
      </div>
      <div class="ingredients-panel" data-facts-panel="ingredients" hidden>
        <h2>Key Ingredients</h2><div class="ingredient-heading"><strong>LipoNAD™ (providing β-NAD⁺ ≥250 mg)</strong><b>500 mg</b></div>
        <p>LipoNAD™ delivers β-NAD directly into cells using liposomes for better absorption. It’s included to boost cellular energy, metabolism, and healthy-aging benefits more effectively.</p>
        <div class="ingredient-heading"><strong>Trans-Resveratrol</strong><b>50 mg</b></div><p>Trans-Resveratrol is included for its antioxidant and anti-inflammatory effects. It helps enhance mitochondrial function and supports the activity of NAD⁺ in the body.</p>
        <h3>Other Ingredients</h3><p>Sunflower Lecithin, Silicon Dioxide, Magnesium Stearate, Microcrystalline Cellulose, Vegetable Cellulose (Capsule).</p>
      </div>
      <button type="button" class="supplement-continue" data-facts-close>Continue</button>
      <div class="supplement-shipping"><span aria-hidden="true">🇺🇸</span> <b>FREE</b> Shipping to USA</div>
    </section>
  </div>
{% endif %}

{% schema %}
{
  "name": "Main product",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9/5 (1000+ reviews)"
    },
    {
      "type": "textarea",
      "id": "clinician_text",
      "label": "Clinician text",
      "default": "Trusted by health professionals and customers building consistent wellness routines."
    },
    {
      "type": "textarea",
      "id": "how_to_use",
      "label": "How to use",
      "default": "Follow the directions on the product label or the advice of a qualified healthcare professional."
    },
    {
      "type": "textarea",
      "id": "safety",
      "label": "Safety",
      "default": "Consult a qualified healthcare professional before use if you are pregnant, nursing, taking medication or managing a medical condition."
    }
  ]
}
{% endschema %}
