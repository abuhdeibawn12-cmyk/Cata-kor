<section class="product-benefits section-shell">
  <div>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.copy }}</p>
  </div>
  <div class="benefit-list">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        <span>✓</span>
        <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.copy }}</p></div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CATA-KOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Support cellular health"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Transparent formulas designed to support everyday energy, cellular resilience and healthy aging.*"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Cellular energy"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Supports normal cellular energy pathways and everyday wellness.*"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product benefits",
      "blocks": [
        { "type": "benefit", "settings": { "heading": "Cellular energy" } },
        { "type": "benefit", "settings": { "heading": "Cellular health" } },
        { "type": "benefit", "settings": { "heading": "Healthy aging" } },
        { "type": "benefit", "settings": { "heading": "Transparent quality" } }
      ]
    }
  ]
}
{% endschema %}
