{% if product.handle == 'nmn' %}
  <section class="nmn-cellular-section">
    <div class="nmn-cellular-copy">
      <span>NMN</span>
      <h2>{{ 'benefits.cellular_title' | t | replace: '<br>', ' ' | replace: '&lt;br&gt;', ' ' }}</h2>
      <p>{{ 'benefits.cellular_copy' | t }}</p>
      <ul>
        <li><span aria-hidden="true">✓</span>{{ 'benefits.energy_support' | t }}</li>
        <li><span aria-hidden="true">✓</span>{{ 'benefits.cellular_support' | t }}</li>
        <li><span aria-hidden="true">✓</span>{{ 'benefits.brain_support' | t }}</li>
        <li><span aria-hidden="true">✓</span>{{ 'benefits.mito_support' | t }}</li>
      </ul>
    </div>
    <img class="nmn-cellular-art" src="https://catakor.com/cdn/shop/files/Image_gp-inline-block_01a37bd0-b432-4a3e-8fb5-ef27f162b876.webp?v=1775054572" alt="Cata-Kor NMN supplement alongside a cellular-health visual" width="900" height="900" loading="lazy">
  </section>

  <section class="nmn-benefits-section">
    <picture>
      <source media="(max-width: 700px)" srcset="https://catakor.com/cdn/shop/files/benefits-img-mob.webp?v=1775054571">
      <img src="https://catakor.com/cdn/shop/files/benefits-img.webp?v=1775054572" alt="Cata-Kor NMN capsules and supplement jar" width="900" height="1200" loading="lazy">
    </picture>
    <div class="nmn-benefits-copy">
      <span>NMN</span>
      <h2>{{ 'benefits.key_title' | t }}</h2>
      <article>
        <img src="https://catakor.com/cdn/shop/files/benefits-icon-1.svg?v=1774889226" alt="" width="40" height="40">
        <div><h3>{{ 'benefits.energy_title' | t }}</h3><p>{{ 'benefits.energy_copy' | t }}</p></div>
      </article>
      <article>
        <img src="https://catakor.com/cdn/shop/files/benefits-icon-2.svg?v=1774889464" alt="" width="40" height="40">
        <div><h3>{{ 'benefits.health_title' | t }}</h3><p>{{ 'benefits.health_copy' | t }}</p></div>
      </article>
      <article>
        <img src="https://catakor.com/cdn/shop/files/benefits-icon-3.svg?v=1774889626" alt="" width="40" height="40">
        <div><h3>{{ 'benefits.mito_title' | t }}</h3><p>{{ 'benefits.mito_copy' | t }}</p></div>
      </article>
      <article>
        <img src="https://catakor.com/cdn/shop/files/benefits-icon-4.svg?v=1774889668" alt="" width="40" height="40">
        <div><h3>{{ 'benefits.brain_title' | t }}</h3><p>{{ 'benefits.brain_copy' | t }}</p></div>
      </article>
    </div>
  </section>

  <section class="nmn-experts-section" data-nmn-experts>
    <div class="nmn-section-heading">
      <div><span>{{ 'benefits.recommended' | t }}</span><h2>{{ 'benefits.experts_title' | t }}</h2></div>
      <div class="nmn-expert-controls">
        <button type="button" data-expert-step="-1" aria-label="Previous expert">←</button>
        <button type="button" data-expert-step="1" aria-label="Next expert">→</button>
      </div>
    </div>
    <div class="nmn-expert-grid" aria-live="polite">
      <article data-expert-card>
        <img src="https://catakor.com/cdn/shop/files/partner-image-1.png?v=1774888818&width=900" alt="Myro Figura" width="900" height="900" loading="lazy">
        <h3>Myro Figura</h3><span>UCLA-Trained MD</span>
        <p><b aria-hidden="true">”</b>I’m usually picky about supplements, but with Cata-Kor’s liposomal absorption technology, I know I’m getting unmatched effectiveness.</p>
      </article>
      <article data-expert-card>
        <img src="https://catakor.com/cdn/shop/files/partner-image-2.jpg?v=1774888818&width=900" alt="Kayla Barnes-Lentz" width="900" height="900" loading="lazy">
        <h3>Kayla Barnes-Lentz</h3><span>A Leading Expert in Female Longevity</span>
        <p><b aria-hidden="true">”</b>NAD+ is non-negotiable in my longevity protocol, and Cata-Kor is a brand I trust. What sets them apart is their rigorous testing standards and commitment to quality.</p>
      </article>
      <article data-expert-card>
        <img src="https://catakor.com/cdn/shop/files/partner-image-3.png?v=1774888818&width=900" alt="Zach Colls" width="900" height="900" loading="lazy">
        <h3>Zach Colls</h3><span>NBA/NFL Physical Rehab Coach</span>
        <p><b aria-hidden="true">”</b>Cata-Kor’s products are exactly what I need: bioavailable, clean, trusted ingredients, and easy to take.</p>
      </article>
      <article data-expert-card>
        <img src="https://catakor.com/cdn/shop/files/partner-image-4.jpg?v=1774888817&width=900" alt="Jenoah McKiver" width="900" height="900" loading="lazy">
        <h3>Jenoah McKiver</h3><span>Olympic Gold Champion</span>
        <p><b aria-hidden="true">”</b>My intense training career has taken a toll. I rely on Cata-Kor to support recovery, longevity, and cognitive health.</p>
      </article>
      <article data-expert-card hidden>
        <img src="https://catakor.com/cdn/shop/files/partner-image-5.jpg?v=1774888818&width=900" alt="Michael Davis" width="900" height="900" loading="lazy">
        <h3>Michael Davis</h3><span>Performance Specialist</span>
        <p><b aria-hidden="true">”</b>I was honestly blown away by how fast I felt the difference in my performance and recovery.</p>
      </article>
    </div>
    <p class="nmn-expert-disclaimer">{{ 'home.paid_ambassadors' | t }}</p>
  </section>

  <section class="nmn-compare-section">
    <div class="nmn-compare-heading">
      <h2>{{ 'benefits.compare_title' | t }}</h2>
      <p>{{ 'benefits.compare_copy' | t }}</p>
    </div>
    <div class="nmn-compare-table" role="table" aria-label="Cata-Kor compared with typical NAD supplements">
      <div class="nmn-compare-labels" role="rowgroup"><b>{{ 'benefits.efficacy' | t }}</b><b>{{ 'benefits.dosage' | t }}</b><b>{{ 'benefits.certification' | t }}</b><b>{{ 'benefits.convenience' | t }}</b><b>{{ 'benefits.price' | t }}</b></div>
      <div class="nmn-compare-brand" role="rowgroup">
        <img src="{{ 'logo.svg' | asset_url }}" alt="Cata-Kor" width="250" height="60">
        <span><b aria-hidden="true">✓</b>{{ 'benefits.all_hallmarks' | t }}</span>
        <span><b aria-hidden="true">✓</b>{{ 'benefits.therapeutic' | t }}</span>
        <span><b aria-hidden="true">✓</b>{{ 'benefits.nsf' | t }}</span>
        <span><b aria-hidden="true">✓</b>{{ 'benefits.two_capsules' | t }}</span>
        <span><b aria-hidden="true">✓</b>$1.13/Day</span>
      </div>
      <div class="nmn-compare-typical" role="rowgroup">
        <strong>{{ 'benefits.typical' | t }}</strong>
        <span><b aria-hidden="true">!</b>{{ 'benefits.one_hallmark' | t }}</span>
        <span><b aria-hidden="true">!</b>{{ 'benefits.underdosed' | t }}</span>
        <span><b aria-hidden="true">×</b>{{ 'benefits.rarely_certified' | t }}</span>
        <span><b aria-hidden="true">×</b>{{ 'benefits.multiple_pills' | t }}</span>
        <span><b aria-hidden="true">×</b>~$3/Day</span>
      </div>
    </div>
  </section>
{% elsif product.handle == 'liposomal-glutathione' %}
  <section class="secondary-quality-strip">
    <div><b>{{ 'benefits.transparent_formula' | t }}</b><span>{{ 'benefits.clear_amounts' | t }}</span></div>
    <div><b>{{ 'benefits.third_party' | t }}</b><span>{{ 'benefits.quality_checked' | t }}</span></div>
    <div><b>{{ 'benefits.money_back' | t }}</b><span>{{ 'benefits.shop_confidence' | t }}</span></div>
  </section>
{% elsif product.handle == 'nad-advanced-500mg' %}
  <section class="result-proof-section" id="results">
    <article class="result-proof-card">
      <img src="https://catakor.com/cdn/shop/files/before-after-image.png?v=1751561115" alt="Aaron before and after eight weeks using Cata-Kor" width="1000" height="550" loading="lazy">
      <div>
        <h2>AARON</h2><h3>Before vs. 8 Weeks using Cata-Kor</h3>
        <p>“I started taking this after noticing low energy. Two months in, I feel sharper, more alert, and feel noticeably healthier.”</p>
        <span>⚡ More Energy</span>
        <small>Taking: <a href="#MainContent">Cata-Kor NAD⁺ Advanced LipoNAD™ 500mg</a></small>
      </div>
    </article>
  </section>
{% endif %}

{% schema %}
{"name":"Exact product benefits","settings":[],"presets":[{"name":"Exact product benefits"}]}
{% endschema %}
