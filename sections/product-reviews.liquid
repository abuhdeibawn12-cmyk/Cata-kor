<section class="reviews-section section-shell">
  <div class="section-heading">
    <div><p class="eyebrow">Real results</p><h2>Customer Reviews</h2></div>
    <span class="review-summary">★★★★★ 5.0 average rating</span>
  </div>

  <div class="review-pages" data-review-pages>
    {% for name in review_names %}
      <article class="review-page{% if forloop.first %} is-active{% endif %}" data-review-page="{{ forloop.index }}">
        <div class="stars">★★★★★</div>
        <h3>{{ review_titles[forloop.index0] }}</h3>
        <p>{{ review_bodies[forloop.index0] }}</p>
        <strong>{{ name }}</strong>
        <small>Verified customer · 06/14/2026</small>
      </article>
    {% endfor %}
  </div>

  <nav class="review-page-nav" aria-label="Customer review pages">
    <button type="button" data-review-page-change="-1" aria-label="Previous review">←</button>
    {% for name in review_names %}<button class="{% if forloop.first %}is-active{% endif %}" type="button" data-review-page-go="{{ forloop.index }}">{{ forloop.index }}</button>{% endfor %}
    <button type="button" data-review-page-change="1" aria-label="Next review">→</button>
  </nav>

  {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
</section>

{% schema %}
{
  "name":"Customer reviews",
  "settings":[],
  "blocks":[{"type":"@app"}],
  "presets":[{"name":"Customer reviews"}]
}
{% endschema %}
