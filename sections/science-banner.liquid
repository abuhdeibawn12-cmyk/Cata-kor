<section class="science-section" id="science">
  <div class="science-live-copy">
    <h2>{{ 'home.science_title' | t }}</h2>
    <p>{{ 'home.science_copy' | t }}</p>
    <div class="science-benefits">
      <div><img src="{{ 'science-quality.svg' | asset_url }}" alt="" width="64" height="64"><b>{{ 'home.quality' | t }}</b></div>
      <div><img src="{{ 'science-dose.svg' | asset_url }}" alt="" width="64" height="64"><b>{{ 'home.transparent' | t }}</b></div>
      <div><img src="{{ 'science-tested.svg' | asset_url }}" alt="" width="64" height="64"><b>{{ 'home.tested' | t }}</b></div>
    </div>
    <a class="primary-button" href="{{ routes.root_url | remove_last: '/' }}/pages/science-benefits">{{ 'home.explore' | t }}</a>
  </div>
  <img class="science-bottle" src="{{ 'science-nmn.webp' | asset_url }}" alt="Cata-Kor NMN Complex" loading="lazy" width="900" height="900">
</section>

{% schema %}
{
  "name": "Cata-Kor science",
  "settings": [],
  "presets": [{ "name": "Cata-Kor science" }]
}
{% endschema %}
