  .product-benefits, .faq-section { grid-template-columns: 1fr; gap: 30px; }
  .about-hero { grid-template-columns: 1fr; }
  .about-hero > div:first-child { padding: 60px 30px; }
  .about-hero > img, .about-hero__placeholder { min-height: 450px; }
}

@media (max-width: 640px) {
  :root { --page: calc(100% - 24px); }
  .announcement { min-height: 25px; font-size: .58rem; }
  .section-shell { padding-block: 55px; }
  .section-heading { display: block; }
  .section-heading .button { margin-top: 15px; }
  .product-grid, .collection-grid { grid-template-columns: 1fr; }
  .expert-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .expert-card { min-width: 82vw; scroll-snap-align: start; }
  .science-points { display: grid; }
  .founder-story { gap: 15px; }
  .site-footer { grid-template-columns: 1fr; gap: 40px; padding: 50px 24px 30px; }
  .footer-disclaimer { grid-column: auto; text-align: left; }
  .product-gallery { grid-template-columns: 1fr; }
  .product-thumbnails { grid-row: 2; grid-auto-flow: column; grid-auto-columns: 70px; overflow-x: auto; }
  .product-media { min-height: 340px; }
  .variant-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; }
  .variant-card { min-height: 145px; padding-inline: 5px; }
  .variant-card img { width: 60px; height: 60px; }
  .variant-card strong { font-size: .8rem; text-align: center; }
  .one-time-price { padding: 14px; }
  .review-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .review-card { min-width: 82vw; scroll-snap-align: start; }
  .science-standards, .science-evidence { grid-template-columns: 1fr; }
  .cart-drawer__panel { padding: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
/* Password storefront */
.password-page {
  min-height: 100vh;
  margin: 0;
  background: #eef3ea;
}

.password-gate {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
  background: linear-gradient(125deg, #cfe4f3 0%, #efffb0 62%, #d9ff72 100%);
  color: #143e24;
}

.password-gate__visual {
  display: grid;
  place-items: center;
  min-height: 100vh;
  overflow: hidden;
}

.password-gate__visual img {
  width: min(92%, 920px);
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 34px 46px rgba(20, 62, 36, 0.2));
}

.password-gate__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(40px, 7vw, 120px);
  background: rgba(250, 252, 247, 0.93);
  backdrop-filter: blur(14px);
}

.brand--password {
  margin-bottom: clamp(54px, 8vh, 100px);
  font-size: clamp(28px, 3vw, 46px);
}

.password-gate h1 {
  max-width: 680px;
  margin: 8px 0 20px;
  font-size: clamp(52px, 6vw, 96px);
  line-height: 0.9;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.password-gate__copy {
  max-width: 540px;
  margin: 0 0 34px;
  font-size: clamp(16px, 1.3vw, 20px);
}

.password-form {
  max-width: 600px;
}

.password-form label {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}

.password-form__row {
  display: flex;
  gap: 10px;
}

.password-form input {
  min-width: 0;
  flex: 1;
  min-height: 52px;
  padding: 0 18px;
  border: 1px solid #9da99e;
  border-radius: 999px;
  background: #fff;
  color: #143e24;
  font: inherit;
}

.password-form__error {
  margin-bottom: 16px;
  color: #9b1c1c;
}

@media (max-width: 760px) {
  .password-gate {
    grid-template-columns: 1fr;
  }

  .password-gate__visual {
    min-height: 42vh;
  }

  .password-gate__content {
    min-height: 58vh;
    padding: 34px 22px 54px;
  }

  .brand--password {
    margin-bottom: 38px;
  }

  .password-form__row {
    flex-direction: column;
  }
}

