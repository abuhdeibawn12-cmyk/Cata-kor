@media (max-width: 1000px) {
  :root { --page: min(100% - 32px, 760px); }
  .site-header { grid-template-columns: auto 1fr auto; min-height: 70px; padding: 10px 16px; gap: 12px; }
  .brand img { width: 140px; }
  .mobile-menu-button { display: block; justify-self: end; }
  .main-nav {
    position: absolute; top: 100%; left: 0; right: 0; display: none;
    padding: 20px; background: white; box-shadow: 0 12px 20px rgba(0,0,0,.08);
  }
  .main-nav.is-open { display: grid; }
  .home-hero { min-height: auto; grid-template-columns: 1fr; }
  .hero-copy { padding: 60px 24px 20px; }
  .hero-visual img { width: 100%; transform: none; }
