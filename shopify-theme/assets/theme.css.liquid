  .science-banner { grid-template-columns: 1fr; padding: 0 24px; }
  .science-banner__product { max-height: 380px; }
  .founder-story { grid-template-columns: 1fr; }
  .founder-story > img { max-height: 480px; margin-inline: auto; }
  .main-product { grid-template-columns: 1fr; gap: 35px; }
