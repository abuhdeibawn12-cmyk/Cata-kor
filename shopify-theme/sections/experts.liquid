{% assign expert_images = 'expert-myro.avif,expert-kayla.webp,expert-zach.webp,expert-jenoah.webp' | split: ',' %}
{% assign expert_names = 'Myro Figura,Kayla Barnes-Lentz,Dr. Zach Colls,Jenoah McKiver' | split: ',' %}
{% assign expert_titles = 'UCLA-Trained MD,A Leading Expert in Female Longevity,NBA/NFL Physical Rehab Coach,Olympic Gold Champion' | split: ',' %}
{% assign expert_quotes = 'Cata-Kor makes effective longevity support straightforward and easy to include in a consistent daily routine.,NAD+ is non-negotiable in my longevity protocol and Cata-Kor is a brand I trust.,The formulas use transparent dosing and trusted ingredients that fit naturally into a wellness routine.,I rely on Cata-Kor to support recovery longevity and cognitive health.' | split: ',' %}

<section class="experts-section">
  <div class="section-heading centered-heading">
    <h2>RECOMMENDED BY HEALTH EXPERTS &amp; ELITE ATHLETES</h2>
    <p>These individuals partner with Cata-Kor as paid ambassadors, sharing their real routines and results.</p>
  </div>
  <div class="expert-grid">
    {% for image in expert_images %}
      <article class="expert-card" data-home-expert>
        <div class="expert-card-flip">
          <div class="expert-card-face expert-card-front">
            <img src="{{ image | asset_url }}" alt="{{ expert_names[forloop.index0] }}" loading="lazy" width="700" height="850">
            <span class="expert-card-scrim" aria-hidden="true"></span>
            <div class="expert-card-front-content">
              <b>{{ expert_names[forloop.index0] }}</b>
              <button class="expert-trigger" type="button" data-home-expert-toggle aria-expanded="false">{{ expert_titles[forloop.index0] }}</button>
            </div>
          </div>
          <button class="expert-card-face expert-card-back" type="button" data-home-expert-toggle aria-label="Hide {{ expert_names[forloop.index0] }} recommendation">
            <span class="expert-avatar"><img src="{{ image | asset_url }}" alt="" width="120" height="120"></span>
            <span class="expert-card-back-copy">
              <b>{{ expert_names[forloop.index0] }}</b>
              <small>{{ expert_titles[forloop.index0] }}</small>
              <span class="quote">“{{ expert_quotes[forloop.index0] }}”</span>
            </span>
          </button>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{"name":"Cata-Kor experts","settings":[],"presets":[{"name":"Cata-Kor experts"}]}
{% endschema %}
