<section class="faq-section section-shell">
  <div class="faq-heading"><p class="eyebrow">FAQs</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="faq-list">
    {% for block in section.blocks %}
      <details {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question }}</span><b>+</b></summary>
        <div>{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? We have answers!"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does it take to see results?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Results vary by product and individual factors. Consistency is important, and some people may require more time than others.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Are there potential side effects?" } },
        { "type": "question", "settings": { "question": "How does Cata-Kor ensure ingredient quality?" } },
        { "type": "question", "settings": { "question": "Are your products safe with medications?" } }
      ]
    }
  ]
}
{% endschema %}
