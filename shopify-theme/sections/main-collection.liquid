<section class="collection-section section-shell">
  <header class="collection-header">
    <p class="eyebrow">Cata-Kor longevity support</p>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}
  </header>

  <div class="collection-toolbar">
    <span>{{ collection.products_count }} products</span>
    <form method="get">
      <label for="SortBy">Sort by</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection-grid">
      {% for product in collection.products %}
        <article class="collection-card {% unless product.available %}is-sold-out{% endunless %}">
          <a href="{{ product.url }}">
            <div class="collection-card__image">
              {% unless product.available %}<span>Out of stock</span>{% endunless %}
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,720,900', alt: product.title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <h2>{{ product.title }}</h2>
            <p>{{ product.description | strip_html | truncatewords: 10 }}</p>
            {% if product.available %}
              <strong>From {{ product.price_min | money }}</strong>
              <span class="button button--dark">View product</span>
            {% else %}
              <strong>Out of stock</strong>
              <span class="button button--disabled">Unavailable</span>
            {% endif %}
          </a>
        </article>
      {% else %}
        <p>No products are assigned to this collection yet.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": []
}
{% endschema %}
