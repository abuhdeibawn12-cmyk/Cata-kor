<section class="password-gate">
  <div class="password-gate__visual" aria-hidden="true">
    <img
      src="{{ 'hero-products-hq.png' | asset_url }}"
      alt=""
      width="1200"
      height="900"
      loading="eager"
    >
  </div>

  <div class="password-gate__content">
    <a class="brand brand--password" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <span class="brand__mark" aria-hidden="true">✦</span>
      <span>Cata·Kor</span>
    </a>

    <p class="eyebrow">Private storefront</p>
    <h1>Age on your terms*</h1>
    <p class="password-gate__copy">
      Enter the store password to preview the Cata-Kor storefront.
    </p>

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <div class="password-form__error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label for="Password">Store password</label>
      <div class="password-form__row">
        <input
          id="Password"
          name="password"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          required
        >
        <button class="button button--dark" type="submit">Enter store</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
