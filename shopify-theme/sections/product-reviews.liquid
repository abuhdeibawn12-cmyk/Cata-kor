  <section class="nmn-reviews-section" id="nmn-reviews" data-nmn-reviews>
    <div class="nmn-reviews-inner">
      <div class="nmn-reviews-heading">
        <div>
          <h2>Customer Reviews</h2>
          <p><b>5.0</b> <span>392 reviews</span></p>
        </div>
        <div class="nmn-review-actions">
          <button type="button" data-review-form-open>Write a review</button>
          <button type="button" data-nmn-review-filter aria-expanded="false">Filter</button>
          <select aria-label="Sort customer reviews">
            <option>Most recent</option>
            <option>Highest rating</option>
            <option>Pictures first</option>
          </select>
        </div>
      </div>

      <label class="nmn-review-filter" data-nmn-review-filter-panel hidden>
        <input type="checkbox" data-pictures-only>
        Show reviews with pictures
      </label>

      <div class="nmn-review-photo-strip" aria-label="Customer review photos">
        {% for review_image in review_images %}
          <button type="button" data-review-picture-filter>
            <img src="{{ review_image }}" alt="Customer review photo {{ forloop.index }}" width="500" height="500" loading="lazy">
          </button>
        {% endfor %}
      </div>

      <div class="nmn-review-pages" data-nmn-review-pages aria-live="polite">
        {% for page_number in (1..20) %}
          {% assign page_offset = page_number | minus: 1 | times: 5 %}
          {% assign quarter_offset = page_number | minus: 1 | divided_by: 4 %}
          {% assign page_offset = page_offset | plus: quarter_offset %}
          <div class="nmn-review-list{% if page_number == 1 %} is-active{% endif %}" data-nmn-review-page="{{ page_number }}" {% unless page_number == 1 %}hidden{% endunless %}>
            {% for item_number in (0..4) %}
              {% assign seed_index = page_offset | plus: item_number | modulo: 20 %}
              {% assign image_index = page_offset | plus: item_number | modulo: 10 %}
              {% assign has_image_mod = item_number | modulo: 2 %}
              <article data-has-review-image="{% if has_image_mod == 1 %}true{% else %}false{% endif %}">
                <div class="nmn-review-stars" aria-label="5 out of 5 stars">★★★★★</div>
                <div class="nmn-reviewer">
                  <span>{{ review_names[seed_index] | slice: 0 }}</span>
                  <div>
                    <b>{{ review_names[seed_index] }}</b>
                    {% if item_number == 0 %}<em>Verified</em>{% endif %}
                    <small>{% if page_number == 1 and item_number == 0 %}07/02/2026{% else %}06/14/2026{% endif %}</small>
                  </div>
                </div>
                <h3>{{ review_titles[seed_index] }}</h3>
                <p>{{ review_bodies[seed_index] }}</p>
                {% if has_image_mod == 1 %}
                  <img class="nmn-review-image" src="{{ review_images[image_index] }}" alt="{{ review_titles[seed_index] }}" width="500" height="500" loading="lazy">
                {% endif %}
                <div class="nmn-reviewed-product">
                  <img src="https://catakor.com/cdn/shop/files/Main_NMN_42c0bc37-5c6c-48ca-a3cc-4ca3790dca55.png?v=1783680309&width=180" alt="" width="180" height="180">
                  <span>Review for<br><u>NMN 4-in-1</u></span>
                </div>
              </article>
            {% endfor %}
          </div>
        {% endfor %}
      </div>

      <nav class="nmn-review-pagination" data-nmn-review-pagination aria-label="Customer review pages"></nav>
      <p class="nmn-review-page-count" data-nmn-review-page-count>Page 1 of 20</p>
    </div>
  </section>

  <div class="nmn-review-dialog-layer" data-review-dialog hidden>
    <section class="nmn-review-dialog" role="dialog" aria-modal="true" aria-labelledby="nmn-review-dialog-title">
      <button type="button" data-review-form-close aria-label="Close review form">×</button>
      <div data-review-form-content>
        <h2 id="nmn-review-dialog-title">Write a review</h2>
        <p class="nmn-dialog-stars">★★★★★</p>
        <form data-review-form>
          <label>Name<input type="text" required></label>
          <label>Review title<input type="text" required></label>
          <label>Your review<textarea rows="5" required></textarea></label>
          <button type="submit">Submit review</button>
        </form>
      </div>
      <div data-review-thanks hidden>
        <h2>Thank you for your review</h2>
        <p>Your feedback has been received for moderation.</p>
      </div>
    </section>
  </div>
