<section class="science-banner">
  <div class="science-banner__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.copy }}</p>
    <div class="science-points">
      <span><img src="{{ 'science-quality.svg' | asset_url }}" alt="" width="48" height="48"> Best-quality ingredients</span>
      <span><img src="{{ 'science-dose.svg' | asset_url }}" alt="" width="48" height="48"> Transparent dosing</span>
      <span><img src="{{ 'science-tested.svg' | asset_url }}" alt="" width="48" height="48"> Third-party tested</span>
    </div>
    <a class="button button--dark" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  </div>
  <img class="science-banner__product" src="{{ 'science-nmn.webp' | asset_url }}" alt="Cata-Kor NMN supplement" loading="lazy" width="900" height="900">
</section>

{% schema %}
{
  "name": "Science banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Longevity support made simple*"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Every ingredient is chosen to support energy, healthy aging and cellular defense for a clear reason.*"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore our science"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/science-benefits"
    }
  ],
  "presets": [
    {
      "name": "Science banner"
    }
  ]
}
{% endschema %}
