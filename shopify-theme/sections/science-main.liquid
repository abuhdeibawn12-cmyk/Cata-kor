      <article class="science-review-card"><img src="{{ image | asset_url }}" alt="{{ review_names[forloop.index0] }}" width="500" height="500"><h3>{{ review_names[forloop.index0] }}</h3><span>Health and performance professional</span><p>“Cata-Kor supports a consistent approach to energy, recovery, and longevity as part of my routine.*”</p><small>{{ forloop.index }} / {{ review_images.size }}</small></article>
