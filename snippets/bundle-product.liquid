{% liquid
  assign bundle_variant = product.selected_or_first_available_variant
  assign bundle_image = blank
  assign bundle_gallery = blank
  assign bundle_badge = 'BUNDLE'
  assign bundle_copy = 'A complementary Cata-Kor formula pairing designed for a simple daily wellness routine.'
  assign bundle_bullets = 'Third-party tested|Made in the USA|Manufactured from globally sourced ingredients' | split: '|'
  assign bundle_composition = blank
  assign nad_gallery = 'https://catakor.com/cdn/shop/files/Main_NAD.png?v=1783679981&width=1600|https://catakor.com/cdn/shop/files/1_NAD500_f37a2f8b-6fd5-43fe-a035-c83a38d54ec4.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/2_NAD500_0ce4c9f5-fb17-4ac1-88c2-d4c4af74fc81.jpg?v=1783421259&width=1600|https://catakor.com/cdn/shop/files/3_NAD500_284becb5-a117-43e4-88d0-7ef566cd05c9.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/4_NAD500_5964a474-23e5-46af-8174-36317bfd56c5.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/5_NAD500_db73c746-222c-4b71-8b49-e692af53d992.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/6_NAD500_0d0e1d1a-b711-4d81-8c41-95cdd9fa436c.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/7_NAD500_Manufactured_for.jpg?v=1783421258&width=1600|https://catakor.com/cdn/shop/files/5_NAD500_a65fca12-ec33-4c89-9817-0919959280a7.jpg?v=1774889169&width=1600|https://catakor.com/cdn/shop/files/7_NAD500_91bae966-e2fe-499f-9161-0c0f42aca355.jpg?v=1774889169&width=1600|https://catakor.com/cdn/shop/files/8_NAD500-2.jpg?v=1774889110&width=1600|https://catakor.com/cdn/shop/files/3_NAD500_8218ca19-959f-4866-9785-0017cff2f5a0.jpg?v=1774889153&width=1600|https://catakor.com/cdn/shop/files/NAD250_2_jars_5e4c06d5-c927-43b1-9da8-f943028f9ece.jpg?v=1774889110&width=1600|https://catakor.com/cdn/shop/files/NAD250_3_jars_33cd95d4-1a11-40c4-a248-3e99cbee0e30.jpg?v=1774889110&width=1600'
  assign nmn_gallery = 'https://catakor.com/cdn/shop/files/Main_NMN_42c0bc37-5c6c-48ca-a3cc-4ca3790dca55.png?v=1783680309&width=1600|https://catakor.com/cdn/shop/files/3_NMN_bbce3af2-5504-48dc-970c-fe25fff2a0ad.jpg?v=1783426601&width=1600|https://catakor.com/cdn/shop/files/2_NMN_053d7393-a9db-469d-8ecb-51880935753c.jpg?v=1783426601&width=1600|https://catakor.com/cdn/shop/files/4_NMN_e27e16fe-9161-41bc-b268-0ce9f64cfd55.jpg?v=1783426609&width=1600|https://catakor.com/cdn/shop/files/7_NMN_1352f876-5cda-4e43-a370-8d14e63d9883.jpg?v=1783426609&width=1600'
  assign glutathione_gallery = 'https://catakor.com/cdn/shop/files/Main_Glu.png?v=1783680082&width=1600|https://catakor.com/cdn/shop/files/2_180af383-77a1-4658-bad6-6f56081aea14.jpg?v=1777301848&width=1600|https://catakor.com/cdn/shop/files/Glu_2.jpg?v=1784023438&width=1600|https://catakor.com/cdn/shop/files/4_76de2ec1-d8f9-4fb4-a973-bcde17ca02e4.jpg?v=1777301849&width=1600|https://catakor.com/cdn/shop/files/Glu_4.jpg?v=1784023438&width=1600|https://catakor.com/cdn/shop/files/32.jpg?v=1783426405&width=1600|https://catakor.com/cdn/shop/files/7139FNgEiTL._AC_SL1500.jpg?v=1784023470&width=1600|https://catakor.com/cdn/shop/files/Glu_7.jpg?v=1784023437&width=1600|https://catakor.com/cdn/shop/files/5_1_b1becfa8-499f-4364-95d8-53ede377bb0a.jpg?v=1780499486&width=1600|https://catakor.com/cdn/shop/files/8_COA_test.png?v=1777037332&width=1600|https://catakor.com/cdn/shop/files/9_2d951678-cb63-4457-94bc-e2479151a650.jpg?v=1780499486&width=1600'
  assign caakg_image = 'product-caakg.avif' | asset_url

  case product.handle
    when 'bundle-nad-nmn'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_NAD.png?v=1783680342'
      assign bundle_gallery = 'https://catakor.com/cdn/shop/files/Main_NMN_NAD.png?v=1783680342&width=1600|https://catakor.com/cdn/shop/files/2_265dc661-93dd-4723-8cf6-3c9138f9c018.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/61JmcdKRxyL._AC_SL1500_299f1d09-6053-4757-bb18-7240b3d34490.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/3_9fc18715-b342-4262-840f-d76f4248430d.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/5_b5ce6d01-0b3e-4657-8bb4-791e3e192e01.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/4_449778d2-09cd-4819-8bc6-1eb19219f0b7.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/10_5c1f1e8d-0111-4a8b-9f5c-8185e4e07b79.jpg?v=1783169420&width=1600|https://catakor.com/cdn/shop/files/6_2d23cc6b-9acf-43b1-a05f-1fc698e87294.jpg?v=1783169420&width=1600'
      assign bundle_copy = 'A two-formula pairing for daily cellular energy and healthy-aging support.*'
      assign bundle_bullets = 'NMN: Supports NAD+ levels*|Quercetin: Supports cellular renewal*|TMG: Supports methylation balance*|Resveratrol: Supports SIRT1 activity*' | split: '|'
    when 'bundle-nmn-glutathione'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_GLU.png?v=1783680215'
      assign bundle_gallery = 'https://catakor.com/cdn/shop/files/Main_NMN_GLU.png?v=1783680215&width=1600|https://catakor.com/cdn/shop/files/1_a4492c5f-0598-4b82-adf0-9bf3547ee037.png?v=1780411784&width=1600|https://catakor.com/cdn/shop/files/2_91acbaea-daa9-4c27-96df-b5caf0741a56.jpg?v=1780411783&width=1600|https://catakor.com/cdn/shop/files/3_cc69d014-2422-4a31-b5bb-174fbe4c8de6.jpg?v=1780411783&width=1600|https://catakor.com/cdn/shop/files/4_e18eb971-bab3-41a4-a2fc-786b37257b8f.jpg?v=1780411784&width=1600|https://catakor.com/cdn/shop/files/5_c57db8f4-becd-4e63-8172-d92e3d574e37.jpg?v=1780411784&width=1600|https://catakor.com/cdn/shop/files/6_7921366a-2559-483b-b9ad-3227de5db08e.jpg?v=1780411783&width=1600|https://catakor.com/cdn/shop/files/7_Glutathione_Manufactured_for-2.jpg?v=1781634843&width=1600|https://catakor.com/cdn/shop/files/8_06d3defd-88b6-4af2-b4b7-e895dd7aee6b.jpg?v=1780411784&width=1600|https://catakor.com/cdn/shop/files/9_08e19dde-9676-41fa-9c7c-78f66a04d6cc.jpg?v=1780411784&width=1600'
      assign bundle_copy = 'A two-formula pairing for cellular energy and antioxidant defense support.*'
      assign bundle_bullets = 'NMN: Supports NAD+ levels*|TMG: Supports methylation balance*|Liposomal glutathione: Supports antioxidant defenses*|Vitamin C: Supports normal immune function*' | split: '|'
    when 'bundle-nad-glutathione'
      assign bundle_composition = 'nad-glutathione'
      assign bundle_gallery = '__bundle_composition__|' | append: nad_gallery | append: '|' | append: glutathione_gallery
      assign bundle_copy = 'A two-formula pairing for cellular energy and antioxidant defense support.*'
      assign bundle_bullets = 'LipoNAD™: Supports cellular energy production*|Resveratrol: Supports healthy cellular function*|Liposomal glutathione: Supports antioxidant defenses*|Vitamin C: Supports normal immune function*' | split: '|'
    when 'bundle-nad-nmn-glutathione'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_NAD_GLU.png?v=1783680368'
      assign bundle_gallery = 'https://catakor.com/cdn/shop/files/Main_NMN_NAD_GLU.png?v=1783680368&width=1600|https://catakor.com/cdn/shop/files/20.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/21.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/22.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/23.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/26.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/27.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/28.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/29.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/31.jpg?v=1783169994&width=1600|https://catakor.com/cdn/shop/files/8_bb2c329e-9771-4220-8260-0d7082e4563d.jpg?v=1783169994&width=1600'
      assign bundle_copy = 'Three complementary formulas for cellular energy, healthy aging and antioxidant defense support.*'
      assign bundle_bullets = 'Third-party tested for identity, purity and quality|Three complementary daily formulas|Made in the USA|Manufactured from globally sourced ingredients' | split: '|'
    when 'bundle-nmn-ca-akg'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_Ca_Akg.png?v=1783680150'
      assign bundle_gallery = bundle_image | append: '|' | append: nmn_gallery | append: '|' | append: caakg_image
    when 'bundle-nad-nmn-ca-akg'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NAD_NMN_Ca_Akg.png?v=1783680182'
      assign bundle_gallery = bundle_image | append: '|' | append: nad_gallery | append: '|' | append: nmn_gallery | append: '|' | append: caakg_image
    when 'bundle-nmn-ca-akg-glutathione'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_CA_Akg_GLU.png?v=1783680255'
      assign bundle_gallery = bundle_image | append: '|' | append: nmn_gallery | append: '|' | append: glutathione_gallery | append: '|' | append: caakg_image
    when 'bundle-nad-nmn-ca-akg-glutathione'
      assign bundle_image = 'https://cdn.shopify.com/s/files/1/0918/3667/8454/files/Main_NMN_Ca_Akg_GLU_NAD.png?v=1783680277'
      assign bundle_gallery = bundle_image | append: '|' | append: nad_gallery | append: '|' | append: nmn_gallery | append: '|' | append: glutathione_gallery | append: '|' | append: caakg_image
  endcase

  assign bundle_gallery_items = bundle_gallery | split: '|'
%}

<section class="bundle-product-hero" data-product-root>
  <div class="bundle-product-gallery secondary-gallery{% if bundle_composition != blank %} has-composition{% endif %}" data-secondary-gallery>
    <div class="secondary-thumbnail-column">
      <button type="button" class="secondary-thumbnail-arrow" data-thumbnail-shift="-1" disabled aria-label="Show previous bundle images">↑</button>
      <div class="secondary-thumbnails" aria-label="Bundle images">
        {% for source in bundle_gallery_items %}
          <button class="{% if forloop.first %}is-active{% endif %}" type="button" data-gallery-index="{{ forloop.index0 }}" {% if forloop.index > 6 %}hidden{% endif %} aria-label="Show bundle image {{ forloop.index }}">
            {% if source == '__bundle_composition__' %}
              <span class="bundle-thumbnail-composition" aria-hidden="true">
                <img src="https://catakor.com/cdn/shop/files/Main_NAD.png?v=1783679981&width=240" alt="" width="240" height="240">
                <img src="https://catakor.com/cdn/shop/files/Main_Glu.png?v=1783680082&width=240" alt="" width="240" height="240">
              </span>
            {% else %}
              <img src="{{ source | replace: 'width=1600', 'width=240' }}" alt="" width="240" height="240" loading="lazy">
            {% endif %}
          </button>
        {% endfor %}
      </div>
      <button type="button" class="secondary-thumbnail-arrow" data-thumbnail-shift="1" aria-label="Show more bundle images">↓</button>
    </div>

    <div class="bundle-main-image secondary-main-image has-star">
      <span class="bundle-gallery-star" aria-hidden="true"></span>
      {% if bundle_composition == 'nad-glutathione' %}
        <span class="bundle-product-composition" data-bundle-composition role="img" aria-label="Cata-Kor NAD+ Advanced and Liposomal Glutathione bundle">
          <img class="is-nad" src="https://catakor.com/cdn/shop/files/Main_NAD.png?v=1783679981&width=1600" alt="" width="1600" height="1600">
          <img class="is-glutathione" src="https://catakor.com/cdn/shop/files/Main_Glu.png?v=1783680082&width=1600" alt="" width="1600" height="1600">
        </span>
        <img src="https://catakor.com/cdn/shop/files/Main_NAD.png?v=1783679981&width=1600" alt="{{ product.title | escape }} product view 1" width="1600" height="1600" data-secondary-main-image hidden>
      {% else %}
        <img src="{{ bundle_image }}" alt="{{ product.title | escape }}" width="1400" height="1400" data-secondary-main-image>
      {% endif %}
      <button class="secondary-image-nav previous" type="button" data-gallery-step="-1" aria-label="Previous bundle image">‹</button>
      <button class="secondary-image-nav next" type="button" data-gallery-step="1" aria-label="Next bundle image">›</button>
    </div>
    <script type="application/json" data-secondary-gallery-json>{{ bundle_gallery_items | json }}</script>
  </div>

  <div class="bundle-product-details">
    <nav class="bundle-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ product.title }}</span></nav>
    <div class="bundle-rating"><span aria-label="5 out of 5 stars">★★★★★</span><b>4.9/5</b></div>
    <div class="bundle-title-row">
      <h1>{{ product.title }}</h1>
      <span>{{ bundle_badge }}</span>
    </div>
    <p class="bundle-intro">{{ bundle_copy }}</p>
    <ul class="bundle-feature-list">
      {% for bullet in bundle_bullets %}<li>{{ bullet }}</li>{% endfor %}
    </ul>
    <strong class="bundle-price">{{ product.price | money_with_currency }}</strong>

    {% if product.available and bundle_variant != blank %}
      <form action="{{ routes.cart_add_url }}" method="post" data-product-form>
        <input type="hidden" name="id" value="{{ bundle_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="bundle-buy-button" type="submit" data-add-to-cart><span data-add-label>BUY NOW</span></button>
      </form>
    {% else %}
      <button class="bundle-buy-button is-disabled" type="button" disabled>SOLD OUT</button>
    {% endif %}
  </div>
</section>
