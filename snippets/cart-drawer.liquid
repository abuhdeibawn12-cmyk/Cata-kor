<div class="global-cart-layer" id="CartDrawer" role="presentation" aria-hidden="true" hidden>
  <aside class="global-cart-drawer" role="dialog" aria-modal="true" aria-labelledby="global-cart-title">
    <div class="global-cart-heading">
      <div>
        <h2 id="global-cart-title">YOUR SHOPPING BAG</h2>
        <p data-cart-summary>
          {% if cart.items.size > 0 %}{{ cart.items.size }} product selection{% unless cart.items.size == 1 %}s{% endunless %}{% else %}Your bag is empty{% endif %}
        </p>
      </div>
      <button type="button" data-cart-close aria-label="Close shopping bag">×</button>
    </div>

    <div data-cart-content>
      {% if cart.items.size == 0 %}
        <div class="global-empty-cart">
          <span>0</span>
          <h3>Your shopping bag is empty</h3>
          <p>Choose a product and build your daily longevity routine.</p>
          <button type="button" data-cart-close>CONTINUE SHOPPING</button>
        </div>
      {% else %}
        {% assign has_flash_eligible_item = false %}
        <div class="global-cart-items" data-cart-items>
          {% for item in cart.items %}
            {% assign is_flash_item = false %}
            {% assign is_bundle_item = false %}
            {% if item.properties._flash_offer == 'true' %}{% assign is_flash_item = true %}{% endif %}
            {% if item.product.type == 'Bundle' or item.product.handle contains 'bundle-' %}{% assign is_bundle_item = true %}{% endif %}
            {% unless is_flash_item %}
              {% unless item.selling_plan_allocation or is_bundle_item %}{% assign has_flash_eligible_item = true %}{% endunless %}
            {% endunless %}
            <article data-line-key="{{ item.key }}">
              {% if item.image %}<img src="{{ item.image | image_url: width: 180 }}" alt="" width="180" height="180">{% endif %}
              <div class="global-cart-item-copy">
                {% if is_flash_item %}<span class="global-flash-label">FLASH SALE · {{ item.properties._flash_discount }}% OFF</span>{% endif %}
                <h3>{{ item.properties._flash_display_title | default: item.product.title }}</h3>
                <p>
                  {{ item.properties._flash_display_variant | default: item.variant.title }} ·
                  {% if item.selling_plan_allocation %}{{ item.selling_plan_allocation.selling_plan.name | default: 'Delivered every month · Save 15%' }}{% else %}One-time purchase{% endif %}
                </p>
                <div class="global-cart-price">
                  {% if is_flash_item and item.properties._flash_original_price_cents %}
                    <del>{{ item.properties._flash_original_price_cents | times: item.quantity | money }}</del>
                  {% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
                <div class="global-cart-quantity">
                  <span>{% if is_flash_item %}Flash bundle quantity{% else %}Bundle quantity{% endif %}</span>
                  {% if is_flash_item %}
                    <div><b aria-label="{{ item.quantity }} flash bundles">{{ item.quantity }}</b></div>
                  {% else %}
                    <div>
                      <button type="button" data-cart-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
                      <b aria-label="{{ item.quantity }} bundles">{{ item.quantity }}</b>
                      <button type="button" data-cart-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
                    </div>
                  {% endif %}
                </div>
              </div>
              <button class="global-cart-remove" type="button" data-cart-remove>Remove</button>
            </article>
          {% endfor %}
        </div>
        {% if has_flash_eligible_item %}
          <div class="global-cart-offer-hint" role="note">
            <span>⚡ Limited One-Time Offer</span>
            <strong>A Private Flash Deal Is Waiting</strong>
            <p>Use the checkout button below to reveal it. No code required.</p>
          </div>
        {% endif %}
        <div class="global-cart-summary"><span>SUBTOTAL</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
        <button class="global-cart-checkout" type="button" data-start-checkout>{% if has_flash_eligible_item %}CHECKOUT &amp; REVEAL OFFER →{% else %}CHECKOUT{% endif %}</button>
        <button class="global-cart-continue" type="button" data-cart-close>CONTINUE SHOPPING</button>
        {% if has_flash_eligible_item %}<p class="global-cart-note">CATA15 can be applied to one-time items at checkout.</p>{% endif %}
      {% endif %}
    </div>
  </aside>
</div>
