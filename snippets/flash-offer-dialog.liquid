<div class="global-offer-layer" id="FlashOfferDialog" role="presentation" hidden>
  <section class="global-offer-dialog" role="dialog" aria-modal="true" aria-labelledby="flash-title">
    <span class="global-offer-eyebrow">CHECKOUT-ONLY FLASH SALE</span>
    <h2 id="flash-title">YOUR PRIVATE BUNDLE OFFERS</h2>
    <p>One limited offer has been prepared for every regular product in your bag.</p>
    <div class="global-offer-grid" data-flash-offers></div>
    <div class="global-offer-actions">
      <button class="global-offer-continue" type="button" data-flash-continue>NO THANKS, CONTINUE</button>
      <button class="global-offer-shop-more" type="button" data-flash-shop-more>SHOP MORE</button>
    </div>
  </section>
</div>
