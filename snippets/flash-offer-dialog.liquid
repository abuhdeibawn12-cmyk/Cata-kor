<div class="global-offer-layer" id="FlashOfferDialog" role="presentation" hidden>
  <section class="global-offer-dialog" role="dialog" aria-modal="true" aria-labelledby="flash-title">
    <span class="global-offer-eyebrow">{{ 'flash.eyebrow' | t }}</span>
    <h2 id="flash-title">{{ 'flash.title' | t }}</h2>
    <p>{{ 'flash.intro' | t }}</p>
    <div class="global-offer-grid" data-flash-offers></div>
    <div class="global-offer-actions">
      <button class="global-offer-continue" type="button" data-flash-continue>{{ 'flash.decline' | t }}</button>
      <button class="global-offer-shop-more" type="button" data-flash-shop-more>{{ 'flash.shop_more' | t }}</button>
    </div>
  </section>
</div>
