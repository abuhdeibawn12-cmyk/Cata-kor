{% liquid
  assign subscription_allocation = selected_allocation | default: selected_variant.selling_plan_allocations.first
  assign delivery_days = selected_delivery_days | default: 30
  assign subscription_savings = selected_subscription_savings
  assign subscription_preview_price = selected_variant.price | times: 85 | divided_by: 100
  assign subscription_display_price = subscription_preview_price
  if subscription_allocation
    assign subscription_display_price = subscription_allocation.price
  endif
  if subscription_savings == blank and subscription_allocation
    assign subscription_savings = selected_variant.price | minus: subscription_allocation.price | money
  elsif subscription_savings == blank
    assign subscription_savings = selected_variant.price | minus: subscription_preview_price | money
  endif
%}

<section class="product-plan-selector{% unless subscription_allocation %} is-preview-only{% endunless %}" data-purchase-options aria-labelledby="purchase-options-title-{{ product.id }}">
    <h2 id="purchase-options-title-{{ product.id }}">{{ 'product.choose_plan' | t }}</h2>

    <button class="plan-option plan-option--subscription" type="button" data-purchase-mode="subscription" aria-pressed="false"{% unless subscription_allocation %} disabled aria-disabled="true"{% endunless %}>
      <span class="plan-option__copy">
        <small data-subscription-badge>{% if enhanced_nmn %}{{ 'product.nmn_subscribe_badge' | t }}{% else %}{{ 'product.subscribe_badge' | t }}{% endif %}</small>
        <b>{{ 'product.subscribe' | t }}</b>
        <em data-subscription-cadence>{{ 'product.delivered_days' | t: days: delivery_days }}</em>
      </span>
      <span class="plan-option__price">
        <s data-plan-compare-price>{{ selected_variant.price | money }}</s>
        <strong data-plan-subscription-price>{{ subscription_display_price | money }}</strong>
        <em>{{ 'product.per_delivery' | t }}</em>
      </span>
    </button>

    <ul class="plan-benefits" aria-label="{{ 'product.subscribe' | t }}">
      <li>{{ 'product.free_shipping' | t }}</li>
      <li{% if enhanced_nmn %} data-subscription-saving-copy{% endif %}>{% if enhanced_nmn %}{{ 'product.save_every_delivery' | t: amount: subscription_savings }}{% else %}{{ 'product.delivery_discount' | t }}{% endif %}</li>
      <li data-subscription-benefit-cadence>{{ 'product.delivered_days' | t: days: delivery_days }}</li>
      <li>{{ 'product.manage_account' | t }}</li>
    </ul>

    <button class="plan-option plan-option--one-time selected" type="button" data-purchase-mode="one-time" aria-pressed="true">
      <span class="plan-option__copy">
        <b>{{ 'product.one_time' | t }}</b>
        <em>{{ 'product.no_recurring' | t }}</em>
      </span>
      <strong data-plan-one-time-price>{{ selected_variant.price | money }}</strong>
    </button>
  </section>
