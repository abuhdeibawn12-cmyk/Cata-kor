{% liquid
  assign subscription_allocation = selected_allocation | default: selected_variant.selling_plan_allocations.first
  assign delivery_days = selected_delivery_days | default: 30
%}

{% if subscription_allocation %}
  <section class="product-plan-selector" data-purchase-options aria-labelledby="purchase-options-title-{{ product.id }}">
    <h2 id="purchase-options-title-{{ product.id }}">Choose Plan</h2>

    <button class="plan-option plan-option--subscription" type="button" data-purchase-mode="subscription" aria-pressed="false">
      <span class="plan-option__copy">
        <small>SUBSCRIBE &amp; SAVE 15%</small>
        <b>Subscribe &amp; Save</b>
        <em data-subscription-cadence>Delivered every {{ delivery_days }} days</em>
      </span>
      <span class="plan-option__price">
        <s data-plan-compare-price>{{ selected_variant.price | money }}</s>
        <strong data-plan-subscription-price>{{ subscription_allocation.price | money }}</strong>
        <em>per delivery</em>
      </span>
    </button>

    <ul class="plan-benefits" aria-label="Subscription benefits">
      <li>Free standard shipping</li>
      <li>15% off every delivery</li>
      <li data-subscription-benefit-cadence>Delivered every {{ delivery_days }} days</li>
      <li>Manage through your account</li>
    </ul>

    <button class="plan-option plan-option--one-time selected" type="button" data-purchase-mode="one-time" aria-pressed="true">
      <span class="plan-option__copy">
        <b>One-Time Purchase</b>
        <em>No subscription or recurring charges</em>
      </span>
      <strong data-plan-one-time-price>{{ selected_variant.price | money }}</strong>
    </button>
  </section>
{% endif %}
